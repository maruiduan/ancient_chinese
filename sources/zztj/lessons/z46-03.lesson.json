{
  "id": "z46-03",
  "lesson": {
    "background": "建初三年，78年。马防击破布桥，羌人多降，耿恭因得罪马防下狱免官。窦贵人被立为皇后。邓训建议停止难成的漕运工程，节省费用、保全役徒。班超攻破姑墨石城。章帝因不忍与诸王分离，把他们留在京城。",
    "theme": "本篇对照了两种臣子。耿恭因「以言事忤马防」而获罪，可见外戚权势之盛；邓训「考量隐括，知其难成，具以上言」，使朝廷「岁省费亿万计，全活徒士数千人」，体现务实的作风。",
    "technique": "本篇篇幅短小，按月份逐条记事。邓训一段先追述明帝时的旧役，「死者不可胜算」写出其害，再写邓训的考察与结果，因果分明；结尾章帝「性笃爱」，留诸王于京师，语气平和。",
    "keyContentWords": [
      {
        "word": "虖",
        "reading": "hū",
        "note": "虖沱，河名。「治虖沱、石臼河」。"
      },
      {
        "word": "辇",
        "reading": "niǎn",
        "note": "车。「更用驴辇」。"
      },
      {
        "word": "溇",
        "reading": "lóu",
        "note": "溇中，地名。「武陵溇中蛮反」。"
      },
      {
        "word": "忤",
        "reading": "wǔ",
        "note": "触犯。「恭尝以言事忤马防」。"
      },
      {
        "word": "胜",
        "reading": "shēng",
        "note": "尽。「死者不可胜算」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "更",
        "reading": "gèng",
        "note": "改。「更用驴辇」。"
      },
      {
        "word": "具",
        "reading": "jù",
        "note": "全部。「具以上言」。"
      },
      {
        "word": "遂",
        "reading": "suì",
        "note": "于是。「遂皆留京师」。"
      }
    ],
    "ancientModern": [
      {
        "word": "隐括",
        "note": "古义指审度实情；今义指概括。「训考量隐括」。"
      },
      {
        "word": "乖离",
        "note": "古义指分离；今义指违背。「不忍与诸王乖离」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "括",
        "note": "同“栝”，隐括即矫正竹木的工具，引申为审度。「训考量隐括」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "全活",
        "note": "形容词作动词，使……保全存活。「全活徒士数千人」。"
      },
      {
        "word": "宗祀",
        "note": "名词作动词，举行宗祀。「宗祀明堂」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "被动句",
        "note": "「坐征下狱」，意念被动。"
      },
      {
        "name": "判断句",
        "note": "「训，禹之子也」，用「也」表判断。"
      },
      {
        "name": "省略句",
        "note": "「具以上言」，省略宾语「之」。"
      }
    ]
  }
