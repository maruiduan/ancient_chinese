{
  "id": "z44-12",
  "lesson": {
    "background": "明帝永平元年，58年。明帝率公卿朝原陵，开上陵之礼。邓禹去世。东海王强病逝，临终上疏谢恩，明帝依其意薄葬。马武破烧当羌。祭肜使偏何破赤山乌桓，边塞罢兵。刘苍议定礼乐。耿弇去世。",
    "theme": "本篇写明帝初年的礼制与安定。刘强「身既夭命」，仍念「愿还东海郡」，谦让至终；明帝「以彰王卓尔独行之志」，成全其德。边事上「野无风尘，乃悉罢缘边屯兵」，四方安宁，刘苍乃「宜修礼乐」。",
    "technique": "本篇以礼仪开篇，以礼乐收束，中间写刘强之死与边功。刘强遗疏情辞哀婉，「诚悲诚惭」叠用；上陵礼仪写得庄重有序。",
    "keyContentWords": [
      {
        "word": "坐",
        "reading": "zuò",
        "note": "座位。「乘舆拜神坐」。"
      },
      {
        "word": "骆驿",
        "reading": "luò yì",
        "note": "即络绎，往来不绝。「骆驿不绝」。"
      },
      {
        "word": "詟",
        "reading": "zhé",
        "note": "恐惧。「塞外震詟」。"
      },
      {
        "word": "菟",
        "reading": "tú",
        "note": "玄菟，郡名。「东尽玄菟」。"
      },
      {
        "word": "佾",
        "reading": "yì",
        "note": "乐舞的行列。「八佾舞数」。"
      },
      {
        "word": "栩",
        "reading": "xǔ",
        "note": "赵王栩，人名。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "惟",
        "reading": "wéi",
        "note": "只，希望。「惟陛下加供养皇太后」。"
      },
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "于是。「乃悉罢缘边屯兵」。"
      },
      {
        "word": "以",
        "reading": "yǐ",
        "note": "用来。「以彰王卓尔独行之志」。"
      }
    ],
    "ancientModern": [
      {
        "word": "上计",
        "note": "古义指地方向朝廷呈报户口钱粮；今义无。「郡国上计吏」。"
      },
      {
        "word": "风尘",
        "note": "古义指战乱；今义指旅途劳顿。「野无风尘」。"
      },
      {
        "word": "小人",
        "note": "古义指平庸之人；今义指品行恶劣的人。「息政，小人也」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "敛",
        "note": "通“殓”。「衣足敛形」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "前",
        "note": "方位名词作动词，上前。「以次前」。"
      },
      {
        "word": "厚",
        "note": "形容词作状语，隆重地。「不欲厚葬以违其意」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「息政，小人也」，以「也」表判断。"
      },
      {
        "name": "省略句",
        "note": "「戊寅，强薨」，以干支纪日领起。"
      },
      {
        "name": "叠句",
        "note": "「诚悲诚惭」，加强情感。"
      }
    ]
  }
}
