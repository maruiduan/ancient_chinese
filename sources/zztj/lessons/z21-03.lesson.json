{
  "id": "z21-03",
  "lesson": {
    "background": "汉武帝元封四年，前107年。武帝出萧关巡行北边。匈奴自漠北之战后远徙，多次遣使请求和亲；汉使王乌、杨信先后出使，单于以甘言相绐，又扣留汉使路充国，并数以奇兵犯边，汉命郭昌屯朔方以备胡。",
    "theme": "本篇写汉匈之间的外交周旋。单于「佯许甘言」，许诺遣太子、入汉见天子，都只是「空绐王乌」，作者揭示了匈奴以和亲为名、求财为实的策略，也说明汉匈关系仍未真正缓和。",
    "technique": "以单于的几番言辞贯穿全篇：先「佯许甘言」，再说「无几矣」，又说「吾欲入汉见天子面」，最后以「单于特空绐王乌」一句揭穿，前后照应，层次分明。",
    "keyContentWords": [
      {
        "word": "度幕",
        "reading": "dù mò",
        "note": "越过大漠。"
      },
      {
        "word": "穹庐",
        "reading": "qióng lú",
        "note": "毡帐。"
      },
      {
        "word": "翁主",
        "reading": "wēng zhǔ",
        "note": "诸侯王的女儿。"
      },
      {
        "word": "绐",
        "reading": "dài",
        "note": "欺骗。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "希",
        "reading": "xī",
        "note": "同“稀”，很少。「希复为寇」。"
      },
      {
        "word": "特",
        "reading": "tè",
        "note": "只是。「单于特空绐王乌」。"
      },
      {
        "word": "殊",
        "reading": "shū",
        "note": "完全，根本。「殊无意入汉及遣太子」。"
      }
    ],
    "ancientModern": [
      {
        "word": "故约",
        "note": "古义指旧日的盟约；今义无此词。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "希",
        "note": "通“稀”，稀少。「希复为寇」。"
      },
      {
        "word": "幕",
        "note": "通“漠”，沙漠。「度幕」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "质",
        "note": "「为遣其太子入汉为质」，名词，人质，读 zhì。"
      },
      {
        "word": "愈",
        "note": "「欲愈之」，动词使动用法，使……痊愈。"
      }
    ],
    "specialSyntax": [
