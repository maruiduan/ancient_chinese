{
  "id": "z43-08",
  "lesson": {
    "background": "建武十九年，43年。马援斩征侧、征贰，平定岭南。东海王刘阳献策缓围，臧宫平定原武妖贼。太子刘彊辞位，光武立刘阳为太子，改名庄；袁宏评论废立。阴识、阴兴辅导太子，桓荣、钟兴授经。董宣格杀湖阳公主家奴，宁死不肯叩头，号「强项令」。光武幸南顿，与父老笑谈。",
    "theme": "本篇人物鲜活。刘阳「宜小挺缓，令得逃亡」，显示了少年的谋略。袁宏指出改立太子「可谓失矣」，又肯定「父子兄弟，至性无间」。董宣「陛下圣德中兴，而纵奴杀人，将何以治天下乎」，不畏权贵，光武「天子不与白衣同」，宽容大度，成为千古佳话。",
    "technique": "本篇董宣一段最为精彩，「以刀画地，大言数主之失」「以头击楹，流血被面」「两手据地，终不肯俯」，动作描写层层推进；公主之言与光武之笑相映成趣，富有戏剧张力。",
    "keyContentWords": [
      {
        "word": "峤",
        "reading": "jiào",
        "note": "山岭。「峤南悉平」。"
      },
      {
        "word": "裒",
        "reading": "póu",
        "note": "鲜于裒，人名。"
      },
      {
        "word": "磬",
        "reading": "qìng",
        "note": "打击乐器。「雅歌击磬」。"
      },
      {
        "word": "骖",
        "reading": "cān",
        "note": "陪乘。「以奴骖乘」。"
      },
      {
        "word": "棰",
        "reading": "chuí",
        "note": "鞭打。「欲棰杀之」。"
      },
      {
        "word": "楹",
        "reading": "yíng",
        "note": "柱子。「即以头击楹」。"
      },
      {
        "word": "栗",
        "reading": "lì",
        "note": "发抖。「京师莫不震栗」。"
      },
      {
        "word": "酿",
        "reading": "niàng",
        "note": "酿造。「多酿毒酒」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "但",
        "reading": "dàn",
        "note": "只是。「但外围急」。"
      },
      {
        "word": "弥",
        "reading": "mí",
        "note": "更加。「谦恭之心弥亮」。"
      },
      {
        "word": "安",
        "reading": "ān",
        "note": "怎么。「安敢远期十岁乎」。"
      }
    ],
    "ancientModern": [
      {
        "word": "故事",
        "note": "古义指旧日成规；今义指有情节的叙述。「自后骆越奉行马将军故事」。"
      },
      {
        "word": "白衣",
        "note": "古义指平民；今义指白色衣服。「文叔为白衣时」。"
      },
      {
        "word": "强项",
        "note": "古义指刚直不屈；今义指擅长的项目。「强项令出」。"
      }
    ],
    "phoneticLoans": [
