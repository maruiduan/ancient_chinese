{
  "id": "z23-12",
  "lesson": {
    "background": "汉昭帝元凤六年，前75年。招募刑徒修筑辽东、玄菟城。乌桓再次侵犯边塞，度辽将军范明友出击。杨敞任丞相，蔡义任御史大夫。",
    "theme": "本篇记事简要，主要涉及东北边防。修筑辽东、玄菟城和派范明友出击乌桓，都说明这一时期乌桓已成为汉朝东北边境的威胁。",
    "technique": "四句记四事，编年体的笔法简洁，只记其事，不加评论。筑城与出击两件事前后相接，读者自能看出朝廷在东北边境既守且攻的部署。",
    "keyContentWords": [
      {
        "word": "徒",
        "reading": "tú",
        "note": "服劳役的犯人。"
      },
      {
        "word": "犯塞",
        "reading": "fàn sài",
        "note": "侵犯边塞。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "复",
        "reading": "fù",
        "note": "再，又。「乌桓复犯塞」。"
      },
      {
        "word": "以",
        "reading": "yǐ",
        "note": "任用。「以杨敞为丞相」。"
      }
    ],
    "ancientModern": [],
    "phoneticLoans": [],
    "flexibleUsage": [
