{
  "id": "z28-03",
  "lesson": {
    "background": "汉元帝初元三年，前46年。元帝下诏撤销珠崖郡，又采纳贡禹的建议，撤销甘泉宫、建章宫的卫士，让他们回家务农。周堪重新被提拔为光禄勋，其弟子张猛任光禄大夫。",
    "theme": "本篇的核心是撤销珠崖郡的诏书。元帝权衡了「羞威不行」「狐疑辟难」「通乎时变」三种考虑，提出「万民之饥饿与远蛮之不讨，危孰大焉」，最终决定放弃珠崖，「民有慕义欲内属，便处之；不欲，勿强」，体现了以民为本的思想。罢甘泉、建章宫卫，也是减轻百姓负担的措施。",
    "technique": "诏书用三个排比句概括了三种不同的意见，然后以设问作结，对比万民之饥与远蛮之不讨，层次清楚，语气恳切。",
    "keyContentWords": [
      {
        "word": "惟思",
        "reading": "wéi sī",
        "note": "思考。"
      },
      {
        "word": "辟难",
        "reading": "bì nán",
        "note": "回避困难。"
      },
      {
        "word": "烝庶",
        "reading": "zhēng shù",
        "note": "百姓。"
      },
      {
        "word": "内属",
        "reading": "nèi shǔ",
        "note": "归附。"
      }
    ],
    "keyFunctionWords": [
      {
