{
  "id": "z43-01",
  "lesson": {
    "background": "光武帝建武十二年，36年。吴汉进逼成都，轻敌分营，几致覆败，后潜师合军大破谢丰；公孙述中刺而死，延岑降，蜀地平定。吴汉纵兵屠掠，光武严词责之。李业、谯玄、王皓、王嘉等不仕公孙述，以死明志。马援治陇西宽简得体；窦融入朝，孔奋清廉独显，任延直言「忠臣不和」。",
    "theme": "本篇写蜀地平定与士人气节。光武「仰视天，俯视地，观放麑、啜羹，二者孰仁」，以仁义责将，见其爱民之心。李业「君子见危授命」，王嘉「犬马犹识主，况于人乎」，表现了乱世中坚守节操的士人风骨。马援「此丞、掾之任，何足相烦」，任延「履正奉公，臣子之节」，都展示了为官之道。",
    "technique": "本篇以战争开篇，以人物群像收束。吴汉激励诸将一段，「成败之机，在此一举」，语言铿锵；光武责刘尚之诏连用设问与典故，情辞激切；李业与尹融的对话一劝一拒，针锋相对；马援「良怖急者，可床下伏」，幽默中见从容。",
    "keyContentWords": [
      {
        "word": "婿",
        "reading": "xù",
        "note": "女婿。「述遣子婿史兴救之」。"
      },
      {
        "word": "晡",
        "reading": "bū",
        "note": "申时，下午三点到五点。「自旦至晡」。"
      },
      {
        "word": "麑",
        "reading": "ní",
        "note": "幼鹿。「观放麑、啜羹」。"
      },
      {
        "word": "啜",
        "reading": "chuò",
        "note": "喝。"
      },
      {
        "word": "赙",
        "reading": "fù",
        "note": "送给丧家的财物。「赙赠百匹」。"
      },
      {
        "word": "癞",
        "reading": "lài",
        "note": "恶疮。「漆身为癞」。"
      },
      {
        "word": "翚",
        "reading": "huī",
        "note": "李翚，人名。"
      },
      {
        "word": "睢",
        "reading": "suī",
        "note": "睢阳，县名。"
      },
      {
        "word": "毂",
        "reading": "gǔ",
        "note": "车轮中心，代指车。「财货连毂」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "比",
        "reading": "bǐ",
        "note": "近来。「比敕公千条万端」。"
      },
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "才。「须其力疲，乃可击也」。"
      },
      {
        "word": "奚",
        "reading": "xī",
        "note": "什么。「死亦奚恨」。"
      }
    ],
    "ancientModern": [
      {
        "word": "心腹",
        "note": "古义指要害之地；今义指亲信。「据其心腹」。"
      },
      {
        "word": "老子",
        "note": "古义为老年人自称；今义多指父亲或道家人物。「颇哀老子，使得遨游」。"
      },
      {
        "word": "脂膏",
        "note": "古义比喻富饶之地；今义指油脂。「以为身处脂膏不能自润」。"
      }
    ],
    "phoneticLoans": [
      {
