        "note": "通“勿”。「忽与争锋」。"
      },
      {
        "word": "阳",
        "note": "通“佯”，假装。「阳狂以避之」。"
      },
      {
        "word": "两",
        "note": "通“辆”。「驾乘千余两」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "城守",
        "note": "名词作状语，据城而守。「诸县皆城守」。"
      },
      {
        "word": "营",
        "note": "名词作动词，扎营。「阻江北营」。"
      },
      {
        "word": "饵",
        "note": "名词作动词，引诱。「何乃诱以高位重饵哉」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "宾语前置",
        "note": "「何妻子之为」，以「之」提前宾语，意为和妻子儿女商量什么。"
      },
      {
        "name": "被动句",
        "note": "「为众人所笑」，用「为……所」表被动。"
      },
      {
        "name": "判断句",
        "note": "「此乃太守事耳」，以「乃」表判断。"
      }
    ]
  }
