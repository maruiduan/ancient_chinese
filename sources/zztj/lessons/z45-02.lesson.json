{
  "id": "z45-02",
  "lesson": {
    "background": "永平五年，62年。刘苍回到封国，明帝给予厚赐。北匈奴侵扰五原、云中，被南单于击退。窦融子孙骄纵不法，窦穆假传太后诏令逼人休妻，诸窦被罢官遣归，窦穆父子后来下狱而死。",
    "theme": "本篇以窦氏的衰败为戒。窦融功高，然而「子孙纵诞，多不法」，窦穆竟「矫称阴太后诏」，终致「下狱死」。外戚之家荣宠过盛而不知收敛，祸及全族，与刘苍的谦退形成对照。",
    "technique": "本篇按时间顺序叙事，前写朝廷常事，后详窦氏之祸。叙窦穆一事先因后果，「帝大怒」三字为转折，「融寻薨」「久之」等时间词串起前后，结构清楚。",
    "keyContentWords": [
      {
        "word": "掾",
        "reading": "yuàn",
        "note": "属官。「掾为中大夫」。"
      },
      {
        "word": "盱",
        "reading": "xū",
        "note": "刘盱，人名。「六安侯刘盱」。"
      },
      {
        "word": "妻",
        "reading": "qì",
        "note": "动词，嫁给。「以女妻之」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "寻",
        "reading": "xún",
        "note": "不久。「融寻薨」。"
      },
      {
        "word": "复",
        "reading": "fù",
        "note": "又。「穆等复坐事」。"
      },
      {
        "word": "皆",
        "reading": "jiē",
        "note": "都。「皆下狱死」。"
      }
    ],
    "ancientModern": [
      {
        "word": "故郡",
        "note": "古义指原籍所在的郡；今义少用。「皆将家属归故郡」。"
      },
      {
        "word": "妇",
        "note": "古义指妻子；今义指妇女。「令六安侯刘盱去妇」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "籓",
        "note": "同“藩”，封国。「苍罢归籓」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "妻",
        "note": "名词作动词，嫁给。「以女妻之」。"
      },
      {
        "word": "尚",
        "note": "动词，娶公主。「尚内黄公主」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "省略句",
        "note": "「独留融京师」，省略介词「于」。"
      },
      {
        "name": "被动句",
        "note": "「皆下狱死」，意念被动。"
      },
      {
        "name": "状语后置",
        "note": "「居雒阳」，地点作补语。"
      }
    ]
  }
