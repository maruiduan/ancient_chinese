{
  "id": "z45-09",
  "lesson": {
    "background": "永平十二年，69年。哀牢王柳貌率众内附，设置哀牢、博南二县，开通博南山道。明帝派王景、王吴修治汴渠，千余里堤防设立水门。这时天下太平，连年丰收，百姓殷富。",
    "theme": "本篇写明帝时的治绩。行者歌「度兰仓，为它人」，透露开边之苦；而王景治水「无复溃漏之患」，解决了长久的水患。末句「粟斛三十，牛羊被野」，是对永平盛世的概括。",
    "technique": "本篇先写开边，再写治水，最后总写民生。治水一段先追述平帝、建武时的旧事，再写「兖、豫百姓怨叹」，然后才写王景受命，因果层层推进，叙事完整。",
    "keyContentWords": [
      {
        "word": "汴",
        "reading": "biàn",
        "note": "汴水。「河、汴决坏」。"
      },
      {
        "word": "浚",
        "reading": "jùn",
        "note": "浚仪，县名。「浚仪令乐俊上言」。"
      },
      {
        "word": "荥",
        "reading": "xíng",
        "note": "荥阳，地名。「自荥阳东至千乘海口千余里」。"
      },
      {
        "word": "乘",
        "reading": "shèng",
        "note": "千乘，地名。「自荥阳东至千乘海口千余里」。"
      },
      {
        "word": "更",
        "reading": "gēng",
        "note": "交替。「令更相洄注」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "于是。「乃止」。"
      },
      {
        "word": "然",
        "reading": "rán",
        "note": "然而。「然犹以百亿计焉」。"
      },
      {
        "word": "焉",
        "reading": "yān",
        "note": "句末语气词。「然犹以百亿计焉」。"
      }
    ],
    "ancientModern": [
      {
        "word": "县官",
        "note": "古义指朝廷；今义指县的长官。「以为县官恒兴佗役」。"
      },
      {
        "word": "百姓",
        "note": "古义指平民；今义同。「百姓殷富」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "它",
        "note": "同“他”，别的。「为它人」。"
      },
      {
        "word": "佗",
        "note": "同“他”，别的。「恒兴佗役」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "急",
        "note": "形容词作名词，急难。「不先民急」。"
      },
      {
        "word": "先",
        "note": "方位词作动词，优先办理。「不先民急」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「粟斛三十」，名词谓语表判断。"
      },
      {
        "name": "省略句",
        "note": "「乃止」，省略主语光武帝。"
      },
      {
        "name": "被动句",
        "note": "「民新被兵革」，用「被」表被动。"
      }
    ]
