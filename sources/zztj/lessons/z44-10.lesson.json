{
  "id": "z44-10",
  "lesson": {
    "background": "中元元年，56年。第五伦得见光武，以清廉著称。光武依谶文决意封禅泰山，详记封禅仪节。改元中元。光武不纳祥瑞上报。起明堂、灵台、辟雍，宣布图谶。桓谭直谏谶纬之非，几被斩首。南单于比死。",
    "theme": "本篇写光武的两面：既谦抑不受祥瑞，又笃信谶纬而封禅。桓谭「臣不读谶」，直言「谶之非经」，险些丧命，范晔叹「世主以此论学，悲哉」，揭示谶纬之风对学术的扭曲。",
    "technique": "本篇详略对比鲜明：封禅仪节铺叙细致，按时辰记程；桓谭进谏则以奏疏与对话推进，「默然，良久曰」写出其挣扎。范晔的论断以三人遭遇对照，简洁有力。",
    "keyContentWords": [
      {
        "word": "篣",
        "reading": "péng",
        "note": "鞭打。「篣妇公」。"
      },
      {
        "word": "燎",
        "reading": "liáo",
        "note": "焚柴祭天。「晨，燎，祭天于泰山下南方」。"
      },
      {
        "word": "晡",
        "reading": "bū",
        "note": "申时。「晡时，升坛北面」。"
      },
      {
        "word": "诖",
        "reading": "guà",
        "note": "贻误。「诖误人主」。"
      },
      {
        "word": "谶",
        "reading": "chèn",
        "note": "预言吉凶的隐语。「吾以谶决之」。"
      },
      {
        "word": "䜣",
        "reading": "xīn",
        "note": "李䜣，人名。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "宁",
        "reading": "nìng",
        "note": "难道。「宁有之邪」。"
      },
      {
        "word": "焉",
        "reading": "yān",
        "note": "怎么。「焉可不抑远之哉」。"
      },
      {
        "word": "况",
        "reading": "kuàng",
        "note": "何况。「况后世浅儒」。"
      }
    ],
    "ancientModern": [
      {
        "word": "妇公",
        "note": "古义指岳父；今义无此用法。「篣妇公」。"
      },
      {
        "word": "故事",
        "note": "古义指旧例；今义指故事情节。「求元封故事」。"
      },
      {
        "word": "图书",
        "note": "古义指河图洛书等谶书；今义指书籍。「增益图书」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "只",
        "note": "“隻”的简化字，单数。「譬犹卜数只偶之类」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "远",
        "note": "形容词作动词，疏远。「焉可不抑远之哉」。"
      },
      {
        "word": "北面",
        "note": "名词作状语，面向北。「升坛北面」。"
      },
      {
        "word": "下",
        "note": "动词，押下去。「将下，斩之」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「逵，扶风人也」，以「也」表判断。"
      },
      {
        "name": "状语前置",
        "note": "「吾以谶决之」，介宾结构「以谶」作状语。"
      },
      {
        "name": "反问句",
        "note": "「况后世浅儒，能通之乎」。"
      }
    ]
  }
}
