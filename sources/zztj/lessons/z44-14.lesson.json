{
  "id": "z44-14",
  "lesson": {
    "background": "永平三年，60年。立马援之女为皇后，她谦肃好读书，衣着朴素。明帝画二十八将于云台，马援以椒房之亲不预。钟离意以旱谏止修北宫。明帝性褊察，药崧以「天子穆穆」自解。莎车王贤与于窴争战。",
    "theme": "本篇写马皇后之德与钟离意之直。马皇后「常衣大练，裙不加缘」，「未尝以家私干政事」，是贤后的典范。钟离意引成汤「六事自责」，「宜且罢止，以应天心」，明帝「勿谢」，从谏如流。明帝「好以耳目隐发为明」，又见其苛察之失。",
    "technique": "本篇人物众多。马皇后部分用细节写德行，「望见后袍衣疏粗，以为绮縠，就视，乃笑」生动有趣；钟离意奏疏以六个问句排比；药崧之语巧妙解围。",
    "keyContentWords": [
      {
        "word": "炟",
        "reading": "dá",
        "note": "刘炟，人名，即后来的章帝。「皇子炟为太子」。"
      },
      {
        "word": "悴",
        "reading": "cuì",
        "note": "劳苦。「劳悴过于所生」。"
      },
      {
        "word": "縠",
        "reading": "hú",
        "note": "有皱纹的纱。「以为绮縠」。"
      },
      {
        "word": "苴",
        "reading": "jū",
        "note": "包裹。「苞苴行邪」。"
      },
      {
        "word": "褊",
        "reading": "biǎn",
        "note": "狭隘。「帝性褊察」。"
      },
      {
        "word": "黼黻",
        "reading": "fǔ fú",
        "note": "礼服上的花纹。「黼黻，冕旒」。"
      },
      {
        "word": "窴",
        "reading": "tián",
        "note": "于窴，国名。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "但",
        "reading": "dàn",
        "note": "只。「但患爱养不至耳」。"
      },
      {
        "word": "若",
        "reading": "ruò",
        "note": "好像。「若恐不及」。"
      },
      {
        "word": "倘",
        "reading": "tǎng",
        "note": "或许。「倘尚可救」。"
      }
    ],
    "ancientModern": [
      {
        "word": "椒房",
        "note": "古义指皇后所居，代指后妃；今义无。「马援以椒房之亲」。"
      },
      {
        "word": "大练",
        "note": "古义指粗厚的帛；今义无。「常衣大练」。"
      },
      {
        "word": "女谒",
        "note": "古义指宫中女子请托；今义无。「女谒盛邪」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "倘",
        "note": "同“傥”，或许。「倘尚可救」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "衣",
        "note": "名词作动词，穿。「常衣大练」。"
      },
      {
        "word": "首",
        "note": "名词作谓语，为首。「以邓禹为首」。"
      },
      {
        "word": "章",
        "note": "动词，彰显。「以章有德」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "疑问句",
        "note": "「政不节邪？」「使民疾邪？」等六问连用自责。"
      },
      {
        "name": "判断句",
        "note": "「后，援之女也」，以「也」表判断。"
      },
      {
        "name": "被动句",
        "note": "「大为休莫霸所败」，用「为……所」表被动。"
      }
    ]
  }
}
