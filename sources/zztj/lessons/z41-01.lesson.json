{
  "id": "z41-01",
  "lesson": {
    "background": "光武帝建武三年，27年。冯异先败于回溪，后大破赤眉于崤底，刘盆子率众投降，赤眉平定。伏隆出使张步被执，上书明志后遇害。光武征邓奉，斩之；冯异平定关中；吴汉、盖延攻破刘永，刘永被部将所杀。耿弇请北定彭宠、张丰，东平张步；来歙请出使隗嚣。",
    "theme": "本篇写光武平定赤眉与关中、梁地。光武慰冯异「失之东隅，收之桑榆」，对赤眉君臣「待汝以不死耳」，显出开国之君的从容与宽厚。伏隆「授命不顾」，劝光武「无以臣隆为念」，忠节动人。吴汉「勃然裹创而起，椎牛飨士」，见出名将临危不乱的气概。",
    "technique": "本篇以赤眉的覆灭为主线，先写邓禹轻进致败，再写冯异设伏取胜，前后对照；赤眉投降一段以对话为主，徐宣「犹去虎口归慈母」之喻生动传神；伏隆奏书情辞恳切，层层推进。",
    "keyContentWords": [
      {
        "word": "渑",
        "reading": "miǎn",
        "note": "渑池，县名。"
      },
      {
        "word": "昃",
        "reading": "zè",
        "note": "太阳偏西。「日昃，贼气衰」。"
      },
      {
        "word": "崤",
        "reading": "xiáo",
        "note": "崤底，地名。"
      },
      {
        "word": "铮",
        "reading": "zhēng",
        "note": "金属声。「铁中铮铮」。"
      },
      {
        "word": "佼",
        "reading": "jiǎo",
        "note": "美好，出众。「佣中佼佼者也」。"
      },
      {
        "word": "盩厔",
        "reading": "zhōu zhì",
        "note": "县名。"
      },
      {
        "word": "淯",
        "reading": "yù",
        "note": "淯阳，县名。"
      },
      {
        "word": "缣",
        "reading": "jiān",
        "note": "细绢。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "且",
        "reading": "qiě",
        "note": "暂且。「可且休」。"
      },
      {
        "word": "犹",
        "reading": "yóu",
        "note": "如同。「犹去虎口归慈母」。"
      },
      {
        "word": "耳",
        "reading": "ěr",
        "note": "罢了。「待汝以不死耳」。"
      }
    ],
    "ancientModern": [
      {
        "word": "妻子",
        "note": "古义指妻子和儿女；今义指男子的配偶。「各与妻子居雒阳」。"
      },
      {
        "word": "无状",
        "note": "古义指没有成绩、没有功劳；今义指行为无礼。「臣隆奉使无状」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "卒",
        "note": "通“猝”，突然。「伏兵卒起」。"
      },
      {
        "word": "要",
        "note": "通“邀”，邀约；拦截。「要冯异共攻赤眉」。"
      },
      {
        "word": "畔",
        "note": "通“叛”，背叛。「吏民知步反畔」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "劳",
        "note": "动词，慰劳。「帝降玺书劳异曰」。"
      },
      {
        "word": "饥",
        "note": "形容词作定语，饥饿的。「数以饥卒徼赤眉战」。"
      },
      {
        "word": "降",
        "note": "使动用法，使投降。「降男女八万人」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "被动句",
        "note": "「大为所败」，用「为所」表被动。"
      },
      {
        "name": "判断句",
        "note": "「此万成计也」，以「……也」表判断。"
      },
      {
        "name": "宾语前置",
        "note": "「何以待之」，疑问代词「何」作介词宾语前置。"
      }
    ]
  }
