{
  "id": "z44-06",
  "lesson": {
    "background": "建武二十八年，52年。东海王强以让位得厚封。马援早年告诫的诸王宾客之祸应验，吕种临死叹「马将军诚神人」。张佚正言傅太子当用贤，桓荣为少傅。北匈奴求和亲，班彪代拟答诏，既不绝北，亦不助南。",
    "theme": "本篇写宗室与外交。马援「诸子并壮而旧防未立，若多通宾客，则大狱起矣」，有先见之明。张佚「为阴氏乎，为天下乎」，直言不讳，光武称善。班彪对北匈奴的策略「羁縻之义，礼无不答」，分寸得当。",
    "technique": "本篇前写宾客之狱，后写和亲之议。张佚之言以设问对举，掷地有声；班彪的答诏草稿层次分明，先褒奖、后讲道理、再讲赏赐，用语庄重而含锋芒。",
    "keyContentWords": [
      {
        "word": "虡",
        "reading": "jù",
        "note": "悬钟的架子。「设钟虡之乐」。"
      },
      {
        "word": "赀",
        "reading": "zī",
        "note": "财产。「磐拥富赀为游侠」。"
      },
      {
        "word": "佚",
        "reading": "yì",
        "note": "张佚，人名。"
      },
      {
        "word": "辎",
        "reading": "zī",
        "note": "有帷盖的车。「赐以辎车」。"
      },
      {
        "word": "韣",
        "reading": "dú",
        "note": "弓袋。「弓鞬韣丸一」。"
      },
      {
        "word": "郅",
        "reading": "zhì",
        "note": "郅支，单于名。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "即",
        "reading": "jí",
        "note": "如果。「即为阴氏，则阴侯可」。"
      },
      {
        "word": "况",
        "reading": "kuàng",
        "note": "何况。「况太子乎」。"
      },
      {
        "word": "裁",
        "reading": "cái",
        "note": "通“才”，仅。「贡物裁以通礼」。"
      }
    ],
    "ancientModern": [
      {
        "word": "游侠",
        "note": "古义指好交游、重义气的人；今义少用。「磐拥富赀为游侠」。"
      },
      {
        "word": "宾客",
        "note": "古义指门客；今义指客人。「为诸王宾客」。"
      },
      {
        "word": "稽古",
        "note": "古义指研习古事；今义少用。「稽古之力也」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "罔",
        "note": "通“网”。「时禁罔尚疏」。"
      },
      {
        "word": "裁",
        "note": "通“才”。「贡物裁以通礼」。"
      }
    ],
    "flexibleUsage": [
      {
