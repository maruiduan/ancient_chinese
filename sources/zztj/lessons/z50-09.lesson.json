{
  "id": "z50-09",
  "lesson": {
    "background": "延光三年，124年。班勇收服龟兹，车师前部复通。安帝东巡，樊丰等伪造诏书大修宅第。杨震屡谏，被诬罢官，饮鸩自尽。南匈奴新降者反叛。王圣、江京等诬陷太子，安帝废太子刘保为济阴王，来历等十余人力争无果。",
    "theme": "本篇最感人的是杨震之死。他上疏指出「亲近幸臣……卖弄威福」，又营救赵腾；被罢官后说「死者，士之常分」，「何面目复见日月」，表现出宁死不屈的气节。来历「独守阙，连日不肯去」，与薛皓临阵变节形成鲜明对比。",
    "technique": "本篇用对比和细节刻画人物。杨震临终遗言要「以杂木为棺，布单被」，朴素而悲壮；移良「露棺道侧，谪震诸子代邮行书」，写出奸佞的狠毒。薛皓「固宜如明诏」与来历「属通谏何言，而今复背之」的对话，人物性格跃然纸上。",
    "keyContentWords": [
      {
        "word": "鸩",
        "reading": "zhèn",
        "note": "毒酒。「因饮鸩而卒」。"
      },
      {
        "word": "谮",
        "reading": "zèn",
        "note": "诬陷。「遂共谮震云」。"
      },
      {
        "word": "怼",
        "reading": "duì",
        "note": "怨恨。「深用怨怼」。"
      },
      {
        "word": "邴",
        "reading": "bǐng",
        "note": "邴吉，人名。「厨监邴吉等」。"
      },
      {
        "word": "伥",
        "reading": "chāng",
        "note": "朱伥，人名。「太中大夫九江朱伥等十余人」。"
      },
      {
        "word": "怫",
        "reading": "fú",
        "note": "愤怒的样子。「历怫然」。"
      },
      {
        "word": "鞮",
        "reading": "dī",
        "note": "单于称号用字。「为乌稽侯尸逐鞮单于」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "会",
        "reading": "huì",
        "note": "恰逢。「会河间男子赵腾上书指陈得失」。"
      },
      {
        "word": "属",
        "reading": "zhǔ",
        "note": "刚才。「属通谏何言」。"
      },
      {
        "word": "固",
        "reading": "gù",
        "note": "本来。「固宜如明诏」。"
      }
    ],
    "ancientModern": [
      {
        "word": "得失",
        "note": "古义指政治上的成败利弊；今义同。「上书指陈得失」。"
      },
      {
        "word": "一切",
        "note": "古义指一律、暂且；今义指全部。「故且一切假贷」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "要",
        "note": "同“邀”，邀请约结。「来历乃要结光禄勋祋讽」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "恶",
        "note": "动词，憎恨。「丰等复恶之」。"
      },
      {
        "word": "诘",
        "note": "动词，质问。「廷诘皓曰」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「死者，士之常分」，判断句。"
      },
      {
        "name": "反问句",
        "note": "「岂事君之礼」，用「岂」表反问。"
      },
      {
        "name": "状语后置",
        "note": "「击走匈奴伊蠡王于伊和谷」，介宾短语后置。"
      }
    ]
  }
