{
  "id": "z22-05",
  "lesson": {
    "background": "汉武帝太始三年，前94年。皇子刘弗陵出生，其母钩弋夫人怀孕十四月，武帝把她生子的门命名为尧母门；司马光认为这是巫蛊之祸的根源之一。江充得到重用，为直指绣衣使者，连太子家使者违制也不放过。",
    "theme": "本篇的核心是司马光的评论：「为人君者，动静举措不可不慎」，命名尧母门「非名也」，使「奸人逆探上意」，终于「卒成巫蛊之祸」。江充「举劾无所避」，在武帝看来是忠直，实则是迎合上意，与太子结下嫌隙，为后文巫蛊之祸埋下伏笔。",
    "technique": "司马光论从小事见大祸，由「命钩弋之门曰尧母」推出「卒成巫蛊之祸」，因果相连，结以「悲夫」，感慨深沉。写江充，「容貌魁岸，被服轻靡」，先写外表；「上以为忠直，所言皆中意」，再写得宠，人物形象鲜明。",
    "keyContentWords": [
      {
        "word": "倢伃",
        "reading": "jié yú",
        "note": "汉代宫中女官名，妃嫔的一种称号。"
      },
      {
        "word": "任身",
        "reading": "rèn shēn",
        "note": "怀孕。"
      },
      {
        "word": "逆探",
        "reading": "nì tàn",
        "note": "预先揣测。"
      },
      {
        "word": "魁岸",
        "reading": "kuí àn",
        "note": "高大魁梧。"
      },
      {
        "word": "驰道",
        "reading": "chí dào",
        "note": "专供天子车马行驶的道路。"
      },
      {
        "word": "亡素",
        "reading": "wú sù",
        "note": "平时没有。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "卒",
        "reading": "zú",
        "note": "终于。「卒成巫蛊之祸」。"
      },
      {
        "word": "由是",
        "reading": "yóu shì",
        "note": "从此。「由是有宠」。"
      },
      {
        "word": "唯",
        "reading": "wéi",
        "note": "表希望。「唯江君宽之」。"
      },
      {
        "word": "夫",
        "reading": "fú",
        "note": "句末语气词，表感叹。「悲夫」。"
      }
    ],
    "ancientModern": [
      {
        "word": "无恙",
        "note": "古义指平安无事；今义多用于问候。「皇后、太子皆无恙」。"
      },
      {
        "word": "中意",
        "note": "古义指合心意；今义同，但多用于口语。「所言皆中意」。"
      }
    ],
    "phoneticLoans": [
