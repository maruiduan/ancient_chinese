{
  "id": "z49-05",
  "lesson": {
    "background": "永初四年，110年。杨震拒收王密送的金子，留下“四知”的佳话。邓骘想放弃凉州，虞诩力陈三不可，张禹采纳。虞诩出任朝歌长，用计平定贼乱。南单于投降。法雄主张借赦令招降海贼。邓骘兄弟为母服丧，班昭劝太后允许。",
    "theme": "本篇人物鲜明。杨震「天知，地知，我知，子知」，「以此遗之，不亦厚乎」，展现清廉自守。虞诩反对弃凉州，指出「关西出将，关东出相」，又说「不遇槃根错节，无以别利器」，有胆有识。法雄认为「兵凶器，战危事」，主张以安抚瓦解贼众，也很有见地。",
    "technique": "本篇多用对话塑造人物。杨震与王密的问答短促有力；虞诩三个「不可」层层递进，论证严密；虞诩与马棱的对话，先抑后扬，写出他的自信。朝歌平贼一段，「设三科」「伏兵」「缝其裾」，计谋接连，情节生动。",
    "keyContentWords": [
      {
        "word": "遗",
        "reading": "wèi",
        "note": "赠送。「夜怀金十斤以遗震」。"
      },
      {
        "word": "劬",
        "reading": "qú",
        "note": "劳苦。「劬劳后定」。"
      },
      {
        "word": "喭",
        "reading": "yàn",
        "note": "同“谚”，俗语。「喭曰」。"
      },
      {
        "word": "疽",
        "reading": "jū",
        "note": "毒疮。「诩恐其疽食侵淫而无限极也」。"
      },
      {
        "word": "槃",
        "reading": "pán",
        "note": "弯曲。「不遇槃根错节」。"
      },
      {
        "word": "贳",
        "reading": "shì",
        "note": "赦免。「悉贳其罪」。"
      },
      {
        "word": "跣",
        "reading": "xiǎn",
        "note": "光着脚。「单于脱帽徒跣」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "微",
        "reading": "wēi",
        "note": "如果没有。「微子之言，几败国事」。"
      },
      {
        "word": "几",
        "reading": "jī",
        "note": "几乎。「几败国事」。"
      },
      {
        "word": "辄",
        "reading": "zhé",
        "note": "就。「吏辄禽之」。"
      }
    ],
    "ancientModern": [
      {
        "word": "故人",
        "note": "古义指老朋友；今义同，也指死去的人。「故人知君」。"
      },
      {
        "word": "明府",
        "note": "古义是对太守的尊称；今义无此用法。「愿明府不以为忧」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "禽",
        "note": "同“擒”。「吏辄禽之」。"
      },
      {
        "word": "陈",
        "note": "同“阵”。「蒙矢石于行陈」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "善",
        "note": "形容词意动用法，以……为善。「禹善其言」。"
      },
      {
        "word": "恶",
        "note": "动词，厌恶。「邓骘由是恶诩」。"
      }
