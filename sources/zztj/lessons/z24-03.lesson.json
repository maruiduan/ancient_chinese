{
  "id": "z24-03",
  "lesson": {
    "background": "汉宣帝本始二年，前72年。大司农田延年贪污僦车钱，不愿受辱下狱，自刎而死。宣帝议为武帝立庙乐，夏侯胜独持异议，与黄霸一同下狱，二人在狱中讲授《尚书》。乌孙公主与昆弥请求汉朝出兵，汉朝发五将军共十六万骑，联合乌孙夹击匈奴。",
    "theme": "本篇最感人的是夏侯胜不惧获罪，直言武帝「无德泽于民，不宜为立庙乐」，坚持「人臣之谊，宜直言正论，非苟阿意顺指」；黄霸在狱中「朝闻道，夕死可矣」，表现出儒者的风骨和求学精神。田延年一段，霍光虽念旧功，却认为「即无事，当穷竟」，田延年宁死不受辱，也写出了他刚烈的个性。",
    "technique": "夏侯胜的议论列举武帝的种种弊政，「多杀士众，竭民财力，奢泰无度」等短句排比而下，语气强烈。田延年自杀前「闭阁独居斋舍，偏袒，持刀东西步」，几个动作描写，刻画出他内心的焦躁和决绝。",
    "keyContentWords": [
      {
        "word": "僦",
        "reading": "jiù",
        "note": "租赁。"
      },
      {
        "word": "道地",
        "reading": "dào dì",
        "note": "留余地，找出路。"
      },
      {
        "word": "偏袒",
        "reading": "piān tǎn",
        "note": "袒露一只胳膊。"
      },
      {
        "word": "物故",
        "reading": "wù gù",
        "note": "死亡。"
      },
      {
        "word": "阿意",
        "reading": "ē yì",
        "note": "迎合别人的心意。"
      },
      {
        "word": "季父",
        "reading": "jì fù",
        "note": "叔父。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "即",
        "reading": "jí",
        "note": "如果，既然。「即无事，当穷竟」。"
      },
      {
        "word": "苟",
        "reading": "gǒu",
        "note": "苟且，随便。「非苟阿意顺指」。"
      },
      {
        "word": "会",
        "reading": "huì",
        "note": "恰逢。「会昭帝崩」。"
      },
      {
        "word": "趣",
        "reading": "cù",
        "note": "赶快。「趣持公主来」。"
      }
    ],
    "ancientModern": [
      {
        "word": "县官",
        "note": "古义指朝廷、官府；今义指县级行政长官。「今县官出三千万自乞之」。"
      },
      {
        "word": "赤地",
        "note": "古义指寸草不生的土地；今义相同。「赤地数千里」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "趣",
        "note": "通“促”，赶快。「趣持公主来」。"
      },
      {
        "word": "指",
        "note": "通“旨”，旨意。「非苟阿意顺指」。"
      },
      {
        "word": "谊",
        "note": "通“义”。「人臣之谊」。"
      }
