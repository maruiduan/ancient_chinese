{
  "id": "z26-01",
  "lesson": {
    "background": "汉宣帝神爵元年，前61年。宣帝喜好神仙祭祀，王褒作《圣主得贤臣颂》，张敞、王吉上疏劝谏。义渠安国滥杀先零首领，激起羌人反叛。七十多岁的赵充国自请出征，坚持先诛先零、招抚罕幵、罢骑屯田的方略，屡次上书与宣帝和公卿辩论，最终使羌人瓦解。",
    "theme": "本篇的主体是赵充国平羌。他主张「百闻不如一见」，亲赴前线；用兵「先计而后战」，对穷寇「缓之则走不顾，急之则还致死」；面对朝廷的催促，坚持「吾固以死守之，明主可为忠言」。屯田奏提出「留屯田得十二便」，体现了以全取胜、「贵谋而贱战」的思想。宣帝能把奏章交公卿反复讨论，赞同者由「什三」到「什八」，也表现了君臣议事的风度。前半王褒的颂与王吉的奏疏，一颂一谏，反映了宣帝朝的风气。",
    "technique": "王褒的颂用大量比喻和排比，「翼乎如鸿毛遇顺风，沛乎如巨鱼纵大壑」，辞藻华美，是汉赋风格的代表。赵充国的奏书则朴实严密，十二条便宜逐条列举，以「一也」「二也」收束，条理井然。两种文风对照鲜明。",
    "keyContentWords": [
      {
        "word": "斥候",
        "reading": "chì hòu",
        "note": "侦察兵，侦察。"
      },
      {
        "word": "衔枚",
        "reading": "xián méi",
        "note": "口中横衔木片，防止出声。"
      },
      {
        "word": "屯田",
        "reading": "tún tián",
        "note": "驻军开垦耕种。"
      },
      {
        "word": "期月",
        "reading": "jī yuè",
        "note": "一整年。"
      },
      {
        "word": "折冲",
        "reading": "zhé chōng",
        "note": "击退敌人。"
      },
      {
        "word": "矻矻",
        "reading": "kū kū",
        "note": "勤劳不懈的样子。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "何则",
        "reading": "hé zé",
        "note": "为什么呢。「何则？」"
      },
      {
        "word": "宁",
        "reading": "nìng",
        "note": "难道。「宁有利哉」。"
      },
      {
        "word": "即",
        "reading": "jí",
        "note": "如果。「即如将军之计」。"
      },
      {
        "word": "卒",
        "reading": "cù",
        "note": "突然。「四夷卒有动摇」。"
      }
    ],
    "ancientModern": [
      {
        "word": "器用",
        "note": "古义指器具，比喻人才；今义少用。「夫贤者，国家之器用也」。"
      },
      {
        "word": "便宜",
        "note": "古义指有利的事情，读 biàn yí；今义指价格低。「臣谨条不出兵留田便宜十二事」。"
      },
      {
        "word": "中国",
        "note": "古义指中原王朝；今义指国家名称。「将军不念中国之费」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "畔",
        "note": "通“叛”。「背畔犯塞」。"
      },
      {
        "word": "册",
        "note": "通“策”，计策。「此全师保胜安边之册」。"
      },
      {
        "word": "亡",
        "note": "通“无”。「而亡后咎余责」。"
      },
      {
        "word": "繇",
        "note": "通“徭”。「繇役豫息」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "老",
        "note": "「上老之」，形容词的意动用法，认为……年老。"
      },
      {
        "word": "饭",
        "note": "「宁子饭牛」，名词用作动词，喂。"
      },
      {
        "word": "贫",
        "note": "「贫破其众」，形容词的使动用法，使……贫困。"
      }
    ],
    "specialSyntax": [
      {
        "name": "被动句",
        "note": "「为虏所击」，用「为……所」表被动。"
      },
      {
        "name": "判断句",
        "note": "「夫贤者，国家之器用也」，用「……者，……也」表判断。"
