{
  "id": "z27-04",
  "lesson": {
    "background": "汉宣帝五凤三年，前55年。丙吉去世，班固称赞丙吉、魏相为中兴名相。黄霸任丞相，误把张敞家的鹖雀当作神雀，被张敞上奏批评；又推荐史高为太尉，受到宣帝责问。广陵王刘胥诅咒宣帝的事被发觉。",
    "theme": "本篇写黄霸为相的得失。黄霸「材长于治民，及为丞相，功名损于治郡」，说明人各有所长。张敞的奏疏批评地方官吏「各为私教，务相增加」，「有名亡实」，主张「郡事皆以法令为检式」，切中虚报政绩之弊。宣帝责问黄霸「君何越职而举之」，表明宣帝重视职守分明。最后仍肯定「言治民吏，以霸为首」，评价公允。",
    "technique": "班固赞语以「元首」「股肱」为喻，说明君臣一体，引出对丙、魏的称颂。张敞奏疏先叙事，再分析危害，最后提出对策，结构完整；鹖雀一事带有讽刺意味。",
    "keyContentWords": [
      {
        "word": "黜陟",
        "reading": "chù zhì",
        "note": "降职和升迁。"
      },
      {
        "word": "鹖雀",
        "reading": "hé què",
        "note": "一种鸟名。"
      },
      {
        "word": "上计",
        "reading": "shàng jì",
        "note": "地方向朝廷呈报户口、赋税等的统计。"
      },
      {
        "word": "检式",
        "reading": "jiǎn shì",
        "note": "准则，法式。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "岂",
        "reading": "qǐ",
        "note": "难道。「岂虚虖哉」。"
      },
      {
        "word": "即",
        "reading": "jí",
        "note": "如果。「即诸侯先行之」。"
      },
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "才。「数日，乃决」。"
      }
    ],
    "ancientModern": [
      {
        "word": "股肱",
        "note": "古义指辅佐的大臣；今义指大腿和胳膊。「臣为股肱」。"
      },
      {
        "word": "指",
        "note": "古义指意旨；今义多指手指。「畏丞相指」。"
      }
    ],
    "phoneticLoans": [
