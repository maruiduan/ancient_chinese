{
  "id": "z48-14",
  "lesson": {
    "background": "元兴元年，105年。高句骊进犯辽东，被耿夔击破。和帝驾崩，邓皇后从民间迎回皇子刘隆即位，即殇帝，太后临朝。太后明察宫中失珠案和吉成冤案。洛阳令王涣去世，百姓设祭报恩，太后任用其子为郎中。",
    "theme": "本篇写邓太后的明察。她「亲阅宫人，观察颜色」，不用拷问就找到盗珠之人；又认为吉成「今反若此，不合人情」，亲自核实，使冤案昭雪，众人「莫不叹服以为圣明」。王涣「外行猛政，内怀慈仁」，是循吏的典范。",
    "technique": "本篇前半写皇位交替，后半写邓太后断案和王涣事迹。断案两件事都用先疑后察的写法；王涣一段借百姓之口「自王君在事，不见侵枉」，写出百姓的感恩，比直接称颂更有力量。",
    "keyContentWords": [
      {
        "word": "骊",
        "reading": "lí",
        "note": "高句骊，国名。「高句骊王宫入辽东塞」。"
      },
      {
        "word": "痼",
        "reading": "gù",
        "note": "久治不愈的病。「有痼疾」。"
      },
      {
        "word": "箧",
        "reading": "qiè",
        "note": "箱子。「宫中亡大珠一箧」。"
      },
      {
        "word": "掖",
        "reading": "yè",
        "note": "掖庭，后宫。「下掖庭考讯」。"
      },
      {
        "word": "擿",
        "reading": "tī",
        "note": "揭发。「能以明察发擿奸伏」。"
      },
      {
        "word": "咨",
        "reading": "zī",
        "note": "叹息。「莫不咨嗟流涕」。"
      },
      {
        "word": "槃",
        "reading": "pán",
        "note": "盘子。「民庶皆设槃案于路」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "辄",
        "reading": "zhé",
        "note": "总是。「后生者辄隐秘养于民间」。"
      },
      {
        "word": "亡",
        "reading": "wáng",
        "note": "丢失。「宫中亡大珠一箧」。"
      },
      {
        "word": "恒",
        "reading": "héng",
        "note": "常常。「恒亡其半」。"
      }
    ],
    "ancientModern": [
      {
        "word": "颜色",
        "note": "古义指脸色；今义指色彩。「观察颜色」。"
      },
      {
        "word": "人情",
        "note": "古义指人之常情；今义多指情面。「不合人情」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "钞",
        "note": "同“抄”，抢夺。「为吏卒所钞」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "首服",
        "note": "动词，自首认罪。「即时首服」。"
      },
      {
        "word": "弦歌",
        "note": "名词作动词，弹琴唱歌。「辄弦歌而荐之」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "被动句",
        "note": "「为吏卒所钞」，用「为……所」表被动。"
      },
      {
        "name": "判断句",
        "note": "「夫忠良之吏，国家之所以为治也」，用「也」表判断。"
      },
      {
        "name": "省略句",
        "note": "「即时首服」，省略主语盗珠者。"
      }
    ]
  }
