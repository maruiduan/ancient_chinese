{
  "id": "z42-03",
  "lesson": {
    "background": "建武八年，32年。来歙袭取略阳，隗嚣倾力围攻不下。光武亲征，马援聚米为山谷，指画形势；窦融率五郡兵来会，隗嚣众十余万降，退保西城。颍川盗起，光武东还，寇恂平之，百姓「复借寇君一年」。汉军围西城，蜀救兵至，粮尽退兵，陇西诸郡复反。温序被俘不屈，伏剑而死。",
    "theme": "本篇写平陇之役的曲折。光武「心腹已坏，则制其支体易矣」，见其战略眼光；「人苦不知足，既平陇，复望蜀」，道出开国之君的辛劳。马援「聚米为山谷」，是中国最早的沙盘推演。温序「既为贼所杀，无令须污土」，以生命捍卫尊严，节烈感人。",
    "technique": "本篇以战争进程为线索，略阳之战与西城之战一胜一挫，起伏跌宕；马援聚米、郭宪断靷等细节传神；温序之死以动作和语言刻画人物，简练有力。",
    "keyContentWords": [
      {
        "word": "靷",
        "reading": "yǐn",
        "note": "引车前行的皮带。「乃当车拔佩刀以断车靷」。"
      },
      {
        "word": "邽",
        "reading": "guī",
        "note": "上邽，县名。"
      },
      {
        "word": "诖",
        "reading": "guà",
        "note": "贻误，蛊惑。「故狂狡乘间相诖误耳」。"
      },
      {
        "word": "檛",
        "reading": "zhuā",
        "note": "击打。「因以节檛杀数人」。"
      },
      {
        "word": "刎",
        "reading": "wěn",
        "note": "割颈。「遂自刎死」。"
      },
      {
        "word": "句",
        "reading": "gōu",
        "note": "高句丽，国名。"
      },
      {
        "word": "黥",
        "reading": "qíng",
        "note": "黥布，人名。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "何其",
        "reading": "hé qí",
        "note": "多么。「何其神也」。"
      },
      {
        "word": "但",
        "reading": "dàn",
        "note": "只。「诸郡甲卒但坐费粮食」。"
      },
      {
        "word": "既",
        "reading": "jì",
        "note": "已经。「既平陇，复望蜀」。"
      }
    ],
    "ancientModern": [
      {
        "word": "草创",
        "note": "古义指刚刚建立；今义指开始创办。「是时军旅草创」。"
      },
      {
        "word": "部曲",
        "note": "古义指军队编制；今义指私人武装。「无擅离部曲」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "冘豫",
        "note": "同“犹豫”。「计冘豫未决」。"
      },
      {
        "word": "卒",
        "note": "通“猝”，突然。「乘高卒至」。"
      },
      {
        "word": "佗",
        "note": "通“他”。「保无佗也」。"
      }
    ],
    "flexibleUsage": [
