{
  "id": "z21-07",
  "lesson": {
    "background": "汉武帝太初二年，前103年。石庆去世，公孙贺拜相时涕泣不受，自知危殆。贰师将军伐宛，沿途小国不给食，至郁成大败，退还敦煌，武帝令「军有敢入者，辄斩之」。赵破奴率二万骑出击匈奴，被生擒，全军覆没。",
    "theme": "本篇写武帝用兵的挫折与对大臣的严苛。公孙贺「顿首涕泣不肯起」，「我从是殆矣」，道出了当时丞相的危险处境。贰师之败，在于「道远乏食」；浞野侯之没，在于「军吏畏亡将而诛」，两次失败都反映了军事决策与军法上的问题。",
    "technique": "公孙贺一段，用「不受印绶，顿首涕泣」和「我从是殆矣」，以动作和语言写心理，简练传神。贰师将军上书与武帝「军有敢入者，辄斩之」对照，一求罢兵，一严拒，矛盾尖锐。",
    "keyContentWords": [
      {
        "word": "督责",
        "reading": "dū zé",
        "note": "督促责备。"
      },
      {
        "word": "饥罢",
        "reading": "jī pí",
        "note": "饥饿疲惫。"
      },
      {
        "word": "什一二",
        "reading": "shí yī èr",
        "note": "十分之一二。"
      },
      {
        "word": "生得",
        "reading": "shēng dé",
        "note": "活捉。"
      },
      {
        "word": "物故",
        "reading": "wù gù",
        "note": "死亡。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "比",
        "reading": "bǐ",
        "note": "接连；等到。「丞相比坐事死」「比至郁成」。"
      },
      {
        "word": "况",
