        "note": "何况。「况至其王都乎」。"
      },
      {
        "word": "辄",
        "reading": "zhé",
        "note": "就，立即。「辄斩之」。"
      },
      {
        "word": "且",
        "reading": "qiě",
        "note": "暂且。「愿且罢兵」。"
      }
    ],
    "ancientModern": [
      {
        "word": "不得已",
        "note": "古义指没有办法；今义同。此处与「拜」连用，指勉强接受任命。"
      },
      {
        "word": "间",
        "note": "古义指暗中、秘密；今义多指中间。「匈奴间捕生得浞野侯」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "罢",
        "note": "通“疲”，疲惫。「皆饥罢」。"
      }
    ],
