  "id": "z28-04",
  "lesson": {
    "background": "汉元帝初元四年，前45年。这一年的记事很简略：元帝正月到甘泉宫郊祀泰畤，三月到河东祭祀后土，并赦免了汾阴的刑徒。",
    "theme": "本篇只有两句，记述了元帝的两次祭祀活动。甘泉泰畤和河东后土是汉武帝以来最重要的国家祭祀，元帝亲自前往，表明他对礼制的重视。「赦汾阴徒」则显示了元帝的宽仁。",
    "technique": "本篇采用编年体最简洁的记事方式，只记时间、地点和事件，不加任何评论，体现了《资治通鉴》“据事直书”的特点。",
    "keyContentWords": [
      {
        "word": "郊",
        "reading": "jiāo",
        "note": "在郊外祭天。"
      },
      {
        "word": "后土",
        "reading": "hòu tǔ",
        "note": "土地神。"
      },
      {
        "word": "徒",
        "reading": "tú",
        "note": "服劳役的犯人。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "上",
        "reading": "shàng",
        "note": "皇上。「上行幸甘泉」。"
      }
    ],
    "ancientModern": [
      {
        "word": "幸",
        "note": "古义指皇帝亲临；今义指幸运。「上行幸甘泉」。"
      }
    ],
    "phoneticLoans": [],
    "flexibleUsage": [
      {
        "word": "郊",
        "note": "「郊泰畤」，名词用作动词，举行郊祭。"
      },
      {
        "word": "祠",
        "note": "「祠后土」，名词用作动词，祭祀。"
      }
    ],
    "specialSyntax": [
      {
        "name": "省略句",
        "note": "「三月，行幸河东」，省略主语「上」。"
      }
