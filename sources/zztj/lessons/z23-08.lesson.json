{
  "id": "z23-08",
  "lesson": {
    "background": "汉昭帝元凤二年，前79年。昭帝从建章宫迁回未央宫。匈奴在受降城屯兵以备汉军，又想求和亲而不肯先说，常让左右向汉使暗示，侵扰日益减少，汉朝也加以笼络。",
    "theme": "本篇篇幅很短，写出了汉匈关系的微妙变化。匈奴「欲求和亲，而恐汉不听，故不肯先言」，既想和好又顾面子，「欲以渐致和亲」；汉朝则「羁縻之」，双方都在试探，边境趋于缓和。",
    "technique": "「欲求和亲，而恐汉不听，故不肯先言，常使左右风汉使者」，一句之中写出匈奴的心理和做法，层层转折，简练细致。",
    "keyContentWords": [
      {
        "word": "风",
        "reading": "fěng",
        "note": "暗示，委婉地劝说。"
      },
      {
        "word": "羁縻",
        "reading": "jī mí",
        "note": "笼络。"
      },
      {
        "word": "渐",
        "reading": "jiàn",
        "note": "逐渐。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "以",
        "reading": "yǐ",
        "note": "用来。「以备汉」。"
      },
      {
        "word": "愈",
        "reading": "yù",
        "note": "越来越。「遇汉使愈厚」。"
      },
      {
        "word": "益",
        "reading": "yì",
        "note": "更加。「其侵盗益希」。"
      }
    ],
    "ancientModern": [],
    "phoneticLoans": [
      {
        "word": "风",
        "note": "通“讽”，暗示。「常使左右风汉使者」。"
      },
      {
        "word": "希",
        "note": "通“稀”。「其侵盗益希」。"
      }
    ],
    "flexibleUsage": [
