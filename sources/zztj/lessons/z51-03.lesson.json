{
  "id": "z51-03",
  "lesson": {
    "background": "永建二年，127年。张国击鲜卑其至鞬。顺帝改葬生母李氏。班勇、张朗攻焉耆，张朗抢先受降，班勇反因后期下狱。许敬为司徒。顺帝隆礼征樊英，樊英到京后无奇谋，令人失望。司马光论君主待隐士之道。李固致书黄琼，黄琼应征任职。",
    "theme": "本篇借樊英一事讨论隐士。司马光认为隐士有真有假：真正的贤人，君主应当「尽礼以致之」；对于「饰伪以邀誉，钓奇以惊俗」的人，则不必征召。李固劝黄琼时说「盛名之下，其实难副」，提醒名声与实际要相符，这句话至今常用。",
    "technique": "本篇议论文字较多。司马光一连用四个问句「岂吾德之薄而不足慕乎」「政之乱而不可辅乎」等，反躬自省，层层递进。李固的书信引「峣峣者易缺，皦皦者易污」作比喻，又以樊英为例，说理与叙事结合，很有说服力。",
    "keyContentWords": [
      {
        "word": "瘗",
        "reading": "yì",
        "note": "埋葬。「帝母李氏瘗在洛阳北」。"
      },
      {
        "word": "徼",
        "reading": "yāo",
        "note": "求取。「欲徼功自赎」。"
      },
      {
        "word": "𫄸",
        "reading": "xūn",
        "note": "浅红色。「玄𫄸」。"
      },
      {
        "word": "訾",
        "reading": "zī",
        "note": "估量。「不訾之身」。"
      },
      {
        "word": "褐",
        "reading": "hè",
        "note": "粗布衣服。「被褐怀玉」。"
      },
      {
        "word": "皦",
        "reading": "jiǎo",
        "note": "洁白。「皦皦者易污」。"
      },
      {
        "word": "笈",
        "reading": "jí",
        "note": "书箱。「负笈从师」。"
      }
    ],
    "keyFunctionWords": [
