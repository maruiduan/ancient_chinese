{
  "id": "z42-05",
  "lesson": {
    "background": "建武十年，34年。吴汉破贾览于平城；冯异斩赵匡、田弇，卒于军中。高峻据高平第一，光武亲征，寇恂斩其军师皇甫文，高峻即日开城投降。来歙破落门，隗纯降，陇右平定，王元奔蜀。来歙又破先零羌，开仓赈济，凉州交通畅通。",
    "theme": "本篇以寇恂招降高峻为核心。寇恂「全之则文得其计，杀之则峻亡其胆」，以斩使示威，迫敌投降，表现了洞察敌情、果断决策的胆识。冯异「固持不动」，坚韧不拔，死于军中。陇右的平定标志着光武统一西北的完成。",
    "technique": "本篇篇幅短小，寇恂一段先写诸将谏阻，再写寇恂斩使，后以问答释疑，设置悬念、层层揭示，富有戏剧性。",
    "keyContentWords": [
      {
        "word": "峻",
        "reading": "jùn",
        "note": "高峻，人名。"
      },
      {
        "word": "戮",
        "reading": "lù",
        "note": "杀。「而反戮其使」。"
      },
      {
        "word": "禀",
        "reading": "lǐn",
        "note": "发放粮食。「于是开仓禀以赈饥乏」。"
      },
      {
        "word": "赈",
        "reading": "zhèn",
        "note": "救济。"
      },
      {
        "word": "隗",
        "reading": "wěi",
        "note": "姓。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "且",
        "reading": "qiě",
        "note": "将近。「战且一年」。"
      },
      {
        "word": "犹",
        "reading": "yóu",
        "note": "仍然。「峻犹不下」。"
      },
      {
        "word": "无乃",
        "reading": "wú nǎi",
        "note": "恐怕。「无乃不可乎」。"
      }
    ],
    "ancientModern": [
      {
        "word": "从容",
        "note": "古义指不慌不忙、悠闲地停留；今义指镇定。「此从容一处」。"
      },
      {
        "word": "腹心",
        "note": "古义指亲信；今义一般不用。「峻之腹心」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "禀",
        "note": "通“廪”，粮仓，引申为发放粮食。「开仓禀以赈饥乏」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "降",
        "note": "使动用法，使……投降。「帝遣寇恂往降之」。"
      },
      {
        "word": "全",
        "note": "使动用法，使……保全。「全之则文得其计」。"
      },
      {
        "word": "急",
        "note": "形容词作状语，赶快。「欲降，急降」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「皇甫文，峻之腹心」，以「……，……」表判断。"
      },
      {
        "name": "宾语前置",
        "note": "「何也」，疑问代词作谓语。"
      },
      {
        "name": "省略句",
        "note": "「不欲，固守」，省略主语和宾语。"
      }
    ]
  }
