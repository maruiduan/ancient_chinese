{
  "id": "z21-10",
  "lesson": {
    "background": "汉武帝天汉元年，前100年。苏武出使匈奴，副使张胜参与虞常劫阏氏的密谋，事泄。苏武引刀自刺，单于壮其节；卫律以富贵威逼利诱，苏武痛骂卫律，誓死不降。单于幽武于大窖，又徙北海牧羝。",
    "theme": "本篇是苏武事迹的主体，突出了他「屈节辱命，虽生，何面目以归汉」的民族气节。卫律的利诱与苏武的斥责形成鲜明对比；「啮雪与旃毛并咽之」「羝乳乃得归」，写出了苏武所受的苦难和匈奴的决心，使苏武的形象更加崇高。",
    "technique": "本篇多用对话塑造人物。卫律先以剑相胁，再以富贵相诱，再以兄弟相劝，层层逼进；苏武先「不动」「不应」，最后一怒而骂，列举南越、大宛、朝鲜的下场，义正辞严。细节描写如「凿地为坎，置煴火」「啮雪与旃毛并咽之」，真实感人。",
    "keyContentWords": [
      {
        "word": "假吏",
        "reading": "jiǎ lì",
        "note": "临时委任的属吏。"
      },
      {
        "word": "阏氏",
        "reading": "yān zhī",
        "note": "匈奴单于的妻子。"
      },
      {
        "word": "煴火",
        "reading": "yūn huǒ",
        "note": "没有火焰的微火。"
      },
      {
        "word": "膏草野",
        "reading": "gào cǎo yě",
        "note": "用尸体肥沃荒野。"
      },
      {
        "word": "羝",
        "reading": "dī",
        "note": "公羊。"
      },
      {
        "word": "旃毛",
        "reading": "zhān máo",
        "note": "毡毛。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "即",
        "reading": "jí",
        "note": "如果。「即谋单于，何以复加」。"
      },
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "才。「见犯乃死」「羝乳乃得归」。"
      },
      {
        "word": "且",
        "reading": "qiě",
        "note": "况且。「且单于信汝」。"
      },
      {
        "word": "尚",
        "reading": "shàng",
        "note": "还。「尚可得乎」。"
      }
    ],
    "ancientModern": [
      {
        "word": "面目",
        "note": "古义指脸面；今义多指相貌或事物的样子。「何面目以归汉」。"
      },
      {
        "word": "亲属",
        "note": "古义指亲族；今义同。此处指与张胜同族。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "畔",
        "note": "通“叛”，背叛。「畔主背亲」。"
      },
      {
        "word": "旃",
        "note": "通“毡”，毡毯。「啮雪与旃毛并咽之」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "壮",
        "note": "「单于壮其节」，形容词意动用法，认为……壮烈。"
      },
      {
        "word": "降",
        "note": "「欲降之」，动词使动用法，使……投降，读 xiáng。"
      },
      {
        "word": "膏",
        "note": "「空以身膏草野」，名词用作动词，滋润肥沃，读 gào。"
      }
    ],
    "specialSyntax": [
      {
        "name": "宾语前置",
        "note": "「何以汝为见」，即“何以见汝为”，宾语「汝」前置。"
      },
      {
        "name": "被动句",
        "note": "「见犯乃死」，用「见」表被动。"
      },
      {
        "name": "反问句",
        "note": "「何面目以归汉」，用「何」表反问。"
      }
    ]
  }
}
