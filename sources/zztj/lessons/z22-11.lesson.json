{
  "id": "z22-11",
  "lesson": {
    "background": "汉武帝后元元年，前88年。马何罗兄弟谋反，持刃入宫，被金日䃅抱住擒获。燕王刘旦求入宿卫，被武帝削县。武帝欲立少子刘弗陵，赐霍光周公负成王图，又赐死钩弋夫人，说明「主少、母壮」是国家动乱的根源。",
    "theme": "本篇写武帝晚年为传位所做的安排。金日䃅「视其志意有非常」，保护武帝，为后文托孤埋下伏笔。立弗陵而杀其母，武帝的解释是「往古国家所以乱，由主少、母壮也」，以吕后为戒，既显示出武帝的深谋远虑，也显示出他的冷酷无情。",
    "technique": "马何罗行刺一段，「何罗袖白刃从东厢上，见日䃅，色变；走趋卧内，欲入，行触宝瑟，僵」，一连串动作描写，紧张而生动。钩弋夫人一段，用「夫人还顾」和「趣行，汝不得活」写出了武帝的决绝，令人震惊。",
    "keyContentWords": [
      {
        "word": "宿卫",
        "reading": "sù wèi",
        "note": "在宫中值宿警卫。"
      },
      {
        "word": "无何",
        "reading": "wú hé",
        "note": "无缘无故。"
      },
      {
        "word": "须臾",
        "reading": "xū yú",
        "note": "一会儿。"
      },
      {
        "word": "伏辜",
        "reading": "fú gū",
        "note": "认罪伏法。"
      },
      {
        "word": "簪珥",
        "reading": "zān ěr",
        "note": "发簪和耳饰。"
      },
      {
        "word": "骄蹇",
        "reading": "jiāo jiǎn",
        "note": "骄横傲慢。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "阴",
        "reading": "yīn",
        "note": "暗中。「阴独察其动静」。"
      },
      {
        "word": "以故",
        "reading": "yǐ gù",
        "note": "因此。「以故久不得发」。"
      },
      {
        "word": "顷之",
        "reading": "qǐng zhī",
        "note": "不久。「顷之，帝闲居」。"
      },
      {
        "word": "所以",
        "reading": "suǒ yǐ",
        "note": "……的原因。「往古国家所以乱」。"
      }
    ],
    "ancientModern": [
      {
        "word": "动静",
        "note": "古义指行动；今义多指声响。「阴独察其动静」。"
      },
      {
        "word": "犹与",
        "note": "古义同“犹豫”；今义无此词。「犹与久之」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "禽",
        "note": "通“擒”，捉拿。「得禽缚之」。"
      },
      {
        "word": "趣",
        "note": "通“促”，赶快。「趣行」。"
      },
      {
        "word": "与",
        "note": "通“豫”。「犹与久之」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "袖",
        "note": "「何罗袖白刃」，名词用作动词，藏在袖中。"
      },
      {
        "word": "奇",
        "note": "「上奇爱之」，形容词作状语，特别地。"
      },
      {
        "word": "恶",
        "note": "「上由是恶旦」，动词，厌恶，读 wù。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「是非儿曹愚人之所知也」，用「是非……也」表否定判断。"
      },
      {
        "name": "反问句",
        "note": "「何去其母乎」，用「何……乎」表反问。"
      }
