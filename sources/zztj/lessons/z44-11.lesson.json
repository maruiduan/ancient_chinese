{
  "id": "z44-11",
  "lesson": {
    "background": "中元二年，57年。光武帝崩于南宫，年六十二。他勤于政事，退功臣进文吏，身致太平。赵熹整肃丧礼。明帝即位，山阳王荆作飞书煽动东海王强，强执使上书。邓禹为太傅，刘苍为骠骑将军。烧当羌叛。",
    "theme": "本篇是对光武一生的总结：「虽以征伐济大业，及天下既定，乃退功臣而进文吏」，「故能恢复前烈，身致太平」。「我自乐此，不为疲也」，见其勤政。刘荆「当为秋霜，无为槛羊」，野心毕露；刘强「即执其使，封书上之」，见其忠谨。",
    "technique": "本篇以光武之死为界，前总结、后转入明帝朝。赵熹「横剑殿阶」一个动作写出威严；刘荆飞书用比喻和反问，煽动性极强，与刘强的惶恐形成对照。",
    "keyContentWords": [
      {
        "word": "昃",
        "reading": "zè",
        "note": "太阳偏西。「日昃乃罢」。"
      },
      {
        "word": "槛",
        "reading": "jiàn",
        "note": "关兽的栅栏。「无为槛羊」。"
      },
      {
        "word": "胪",
        "reading": "lú",
        "note": "大鸿胪，官名。「大鸿胪郭况」。"
      },
      {
        "word": "滇",
        "reading": "diān",
        "note": "滇良、滇吾，羌人名。"
      },
      {
        "word": "盱",
        "reading": "xū",
        "note": "刘盱，人名。"
      },
      {
        "word": "鞮",
        "reading": "dī",
        "note": "单于名号用字。「伊伐于虑鞮单于」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "才。「日昃乃罢」。"
      },
      {
        "word": "其",
        "reading": "qí",
        "note": "表祈使。「其以禹为太傅」。"
      },
      {
        "word": "何况",
        "reading": "hé kuàng",
        "note": "何况。「何况于王」。"
      }
    ],
    "ancientModern": [
      {
        "word": "文吏",
        "note": "古义指文职官吏；今义少用。「乃退功臣而进文吏」。"
      },
      {
        "word": "苍头",
        "note": "古义指奴仆；今义少用。「令苍头诈称」。"
      },
      {
        "word": "小子",
        "note": "古义为自谦之称；今义含贬义。「实赖有德左右小子」。"
      }
    ],
    "phoneticLoans": [],
