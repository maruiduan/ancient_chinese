{
  "id": "z42-02",
  "lesson": {
    "background": "建武七年，31年。罢郡国轻车、骑士、材官。郑兴因日食上疏，请光武「屈己从众」，宽缓为政。陈元谏止司隶督察三公，以王莽猜忌群臣为鉴。隗嚣侵安定、汧县无功而还。光武好图谶，郑兴不为谶，几获罪。南阳太守杜诗兴利除害，民称「前有召父，后有杜母」。",
    "theme": "本篇多写臣下进谏。郑兴借天象言人事，劝光武「留思柔克之政」；陈元「师臣者帝，宾臣者霸」，强调君主应「劳心下士，屈节待贤」。郑兴以「臣于书有所未学，而无所非也」巧妙化解光武之怒，表现了守正而不失分寸的进谏艺术。",
    "technique": "本篇以奏疏为主体，陈元疏先举正面典范，再以王莽为反面教训，正反对照，说理透彻；郑兴与光武的问答简短而富有张力；结尾以民谣作结，简洁生动。",
    "keyContentWords": [
      {
        "word": "谪",
        "reading": "zhé",
        "note": "谴责，天象示警。「则谪见日月」。"
      },
      {
        "word": "亢",
        "reading": "kàng",
        "note": "刚强。「君亢急而臣下促迫」。"
      },
      {
        "word": "讦",
        "reading": "jié",
        "note": "揭发隐私。「徼讦为直」。"
      },
      {
        "word": "罔",
        "reading": "wǎng",
        "note": "网。「罔密法峻」。"
      },
      {
        "word": "竺",
        "reading": "zhú",
        "note": "姓。"
      },
      {
        "word": "肜",
        "reading": "róng",
        "note": "辛肜，人名。"
      },
      {
        "word": "槃",
        "reading": "pán",
        "note": "阴槃，地名。"
      },
      {
        "word": "陂",
        "reading": "bēi",
        "note": "池塘。「又修治陂池」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "则",
        "reading": "zé",
        "note": "就。「则谪见日月」。"
      },
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "竟然。「至乃陪仆告其君长」。"
      },
      {
        "word": "而",
        "reading": "ér",
        "note": "表转折，却。「而无所非也」。"
      }
    ],
    "ancientModern": [
