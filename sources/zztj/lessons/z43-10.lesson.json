{
  "id": "z43-10",
  "lesson": {
    "background": "建武二十一年，45年。刘尚平定西南夷。乌桓、匈奴、鲜卑连兵为寇，边陲萧条；马援筑塞招民，攻乌桓无功。祭肜大破鲜卑，鲜卑不敢窥塞。莎车王贤骄横，十八国遣子入侍，请都护，光武以中国初定不许。",
    "theme": "本篇写东汉初年的边疆困境。「朝发穹庐，暮至城郭」形象地描写了游牧骑兵的机动性，「边陲萧条，无复人迹」写出边地的凋敝。祭肜「自被甲陷阵」，体现了守将的勇武。光武拒绝都护之请，表明其以内政为先的务实政策。",
    "technique": "本篇描写简练，「朝发穹庐，暮至城郭」以对比写速度；鲜卑败逃「弃兵裸身散走」，形象生动；西域诸国「皆流涕稽首」，写出求援的急切。",
    "keyContentWords": [
      {
        "word": "穹庐",
        "reading": "qióng lú",
        "note": "毡帐。「朝发穹庐」。"
      },
      {
        "word": "辜",
        "reading": "gū",
        "note": "罪过，祸害。「家受其辜」。"
      },
      {
        "word": "陲",
        "reading": "chuí",
        "note": "边境。「边陲萧条」。"
      },
      {
        "word": "裸",
        "reading": "luǒ",
        "note": "光着身子。「皆弃兵裸身散走」。"
      },
      {
        "word": "窥",
        "reading": "kuī",
        "note": "窥伺。「不敢复窥塞」。"
      },
      {
        "word": "稽首",
        "reading": "qǐ shǒu",
        "note": "叩头至地。「皆流涕稽首」。"
      },
      {
        "word": "檄",
        "reading": "xí",
        "note": "文书。「乃与敦煌太守檄」。"
      }
    ],
    "keyFunctionWords": [
      {
