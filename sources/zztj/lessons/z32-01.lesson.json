{
  "id": "z32-01",
  "lesson": {
    "background": "汉成帝永始四年，前13年。梁王刘立骄纵犯法，又被揭发与姑母通奸，谷永上书劝成帝不要追究，成帝搁置此案。何武任京兆尹。",
    "theme": "本篇核心是谷永为梁王开脱的上书。他以「《春秋》为亲者讳」为据，认为揭发「闺门之私」「非本章所指」，「污蔑宗室以内乱之恶」有损朝廷荣誉，主张「萌牙之时，加恩勿治」。这体现了汉代亲爱亲属的观念，但也反映出宗室犯法往往得到包庇。篇末写何武「其所居无赫赫名，去后常见思」，是对良吏的赞誉。",
    "technique": "谷永的上书层层推理，以「三者揆之，殆非人情」归纳论证，既为梁王开脱，又顾全朝廷体面，措辞周到。",
    "keyContentWords": [
      {
        "word": "中冓",
        "reading": "zhōng gòu",
        "note": "宫室内部，指闺门隐私。"
      },
      {
        "word": "揆",
        "reading": "kuí",
        "note": "揣度。"
      },
      {
        "word": "萌牙",
        "reading": "méng yá",
        "note": "开始发生。"
      },
      {
        "word": "寝",
        "reading": "qǐn",
        "note": "搁置。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "殆",
        "reading": "dài",
        "note": "大概。「殆非人情」。"
      },
      {
        "word": "乃",
        "reading": "nǎi",
        "note": "却。「案事者乃验问恶言」。"
      },
      {
        "word": "何故",
        "reading": "hé gù",
        "note": "为什么。「何故猥自发舒」。"
      }
    ],
    "ancientModern": [
      {
        "word": "同产",
        "note": "古义指同母所生的兄弟姐妹；今义无此用法。「王少而父同产长」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "牙",
        "note": "通“芽”。「萌牙之时」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "讳",
        "note": "「《春秋》为亲者讳」，动词，隐讳。"
      },
      {
        "word": "思",
        "note": "「去后常见思」，动词，思念。"
      }
    ],
    "specialSyntax": [
      {
        "name": "被动句",
        "note": "「去后常见思」，用「见」表被动。"
      },
      {
        "name": "判断句",
        "note": "「萌牙之时，加恩勿治，上也」，用「……也」表判断。"
      }
    ]
  }
