{
  "id": "z45-01",
  "lesson": {
    "background": "汉明帝永平四年，61年。明帝想出游打猎，东平王刘苍上书劝止。梁松因怨望诽谤下狱而死，郑众因当年拒绝私交太子而未受牵连。于窴吞并莎车，刘苍屡次请求归还将军印绶回国。",
    "theme": "本篇以人物操守为线索。郑众面对「长者意，不可逆」的压力，回答「犯禁触罪，不如守正而死」，终得「不染于辞」；刘苍「声望日重，意不自安」，主动退让，都写出明哲保身的分寸。",
    "technique": "本篇叙事详略得当，郑众一事以对话推进，两问两答，简洁有力；末段刘苍上疏只引一句要旨，「辞甚恳切」四字概括其余，结尾「不听上将军印绶」见明帝的倚重。",
    "keyContentWords": [
      {
        "word": "窴",
        "reading": "tián",
        "note": "于窴，西域国名。「于窴王广德」。"
      },
      {
        "word": "莎",
        "reading": "shā",
        "note": "莎车，西域国名。「攻莎车」。"
      },
      {
        "word": "缣",
        "reading": "jiān",
        "note": "细绢。「以缣帛请之」。"
      },
      {
        "word": "乘",
        "reading": "shèng",
        "note": "千乘，国名。「千乘哀王建薨」。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "因",
        "reading": "yīn",
        "note": "通过。「因梁松以缣帛请之」。"
      },
      {
        "word": "遂",
        "reading": "suì",
        "note": "于是。「遂不往」。"
      },
      {
        "word": "唯",
        "reading": "wéi",
        "note": "只有。「唯众不染于辞」。"
      }
    ],
    "ancientModern": [
      {
        "word": "宾客",
        "note": "古义指依附权贵的门客；今义指客人。「宾客多坐之」。"
      },
      {
        "word": "长者",
        "note": "古义指显贵之人；今义指年长者。「长者意」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "县",
        "note": "同“悬”，悬挂。「县飞书诽谤」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "坐",
        "note": "动词，因……获罪。「宾客多坐之」。"
      },
      {
        "word": "染",
        "note": "动词，牵连。「不染于辞」。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「恭，湛之兄子也」，用「也」表判断。"
      },
      {
        "name": "被动句",
        "note": "「下狱死」，意念被动。"
      },
      {
        "name": "比较句",
        "note": "「不如守正而死」，用「不如」比较。"
      }
    ]
  }
}
