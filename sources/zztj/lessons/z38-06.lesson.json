{
  "id": "z38-06",
  "lesson": {
    "background": "王莽地皇元年，20年。王莽改元地皇，下令春夏斩人，百姓道路以目。王莽置五大司马，州牧县宰皆加将军之号。大风毁王路堂，王莽改立王安、王临之号。王莽起九庙，功费巨万。马适求谋诛王莽，事泄被杀。唐尊以俭饰名，郅恽上书劝王莽还位。",
    "theme": "本篇写王莽在动乱中的倒行逆施。他「方出军行师」，敢有犯法者「辄论斩，毋须时」，于是「百姓震惧，道路以目」。大风毁堂，他「伏念一旬」，结论竟是太子「名不正」；又大兴九庙，「卒徒死者万数」。唐尊「乘牝马、柴车」，「以历遗公卿」，以俭约邀名，王莽却「闻而说之」。郅恽直言「取之以天，还之以天」，敢于犯颜，与群臣的谄媚形成对照。",
    "technique": "本篇多处引用王莽诏书原文，以其冠冕堂皇的言辞对照混乱的现实，不着评语而讽意自明；唐尊一段以细节描写刻画伪饰之态。",
    "keyContentWords": [
      {
        "word": "讙",
        "reading": "huān",
        "note": "喧哗。"
      },
      {
        "word": "宄",
        "reading": "guǐ",
        "note": "作乱的人。"
      },
      {
        "word": "瘳",
        "reading": "chōu",
        "note": "病愈。"
      },
      {
        "word": "牝",
        "reading": "pìn",
        "note": "雌性的。"
      },
      {
        "word": "赭",
        "reading": "zhě",
        "note": "红褐色。"
      },
      {
        "word": "郅",
        "reading": "zhì",
        "note": "姓氏用字。"
      }
    ],
    "keyFunctionWords": [
      {
        "word": "辄",
        "reading": "zhé",
        "note": "立即。「辄论斩」。"
      },
      {
        "word": "且",
        "reading": "qiě",
        "note": "将近。「日且十辈」。"
      },
      {
        "word": "厥",
        "reading": "jué",
        "note": "其，他的。「深惟厥咎」。"
      }
    ],
    "ancientModern": [
      {
        "word": "道路以目",
        "note": "古义指在路上相遇只能以目示意，形容暴政下百姓不敢说话；今义同为成语。「百姓震惧，道路以目」。"
      },
      {
        "word": "征营",
        "note": "古义指惶恐不安；今义无此词。「人民征营」。"
      }
    ],
    "phoneticLoans": [
      {
        "word": "错",
        "note": "通“措”，安放。「无所错手足」。"
      },
      {
        "word": "说",
        "note": "通“悦”。「莽闻而说之」。"
      },
      {
        "word": "见",
        "note": "通“现”。「仓无见谷以给」。"
      }
    ],
    "flexibleUsage": [
      {
        "word": "衣",
        "note": "「其令郎从官皆衣绛」，名词用作动词，穿。"
      },
      {
        "word": "宝",
        "note": "「宝黄厮赤」，意动用法，以……为宝贵。"
      }
    ],
    "specialSyntax": [
      {
        "name": "判断句",
        "note": "「临有兄而称太子，名不正」，以名词性谓语作判断。"
      },
      {
        "name": "省略句",
        "note": "「封丹为辅国侯」，省略主语「莽」。"
      }
    ]
  }
