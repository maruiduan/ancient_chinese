      "id": "s007",
      "collection": "史记",
      "change": "舉所佩玉珪 → 玉玦",
      "resolution": "维基文库作玉珪。中华书局点校本、《资治通鉴》卷九、统编教材《鸿门宴》都作玉玦，从玦。"
    },
    {
      "id": "s007",
      "collection": "史记",
      "change": "井殺樅公 → 并殺樅公",
      "resolution": "井是并的形近误字。从中华书局点校本。"
    },
    {
      "id": "s007",
      "collection": "史记",
      "change": "（北）［比］、（郡）",
      "resolution": "维基文库照点校本标删补：圆括号里的字删去，方括号里的字补入。"
    },
    {
      "id": "s007",
      "collection": "史记",
      "change": "简体閒 → 间",
      "resolution": "本篇閒都是间道、离间、广武间的间。OpenCC 收成闲，改作间。"
    },
    {
      "id": "renjian",
      "collection": "人间词话",
      "change": "雞犬不已 → 雞鳴不已",
      "resolution": "所引《诗经》是鸡鸣不已，不是鸡犬不已。"
    },
    {
      "id": "renjian",
      "collection": "人间词话",
      "change": "莫之興京 → 莫之與京",
      "resolution": "萧统《陶渊明集序》作莫之与京。"
    },
    {
      "id": "renjian",
      "collection": "人间词话",
      "change": "玉固、草窗 → 玉田、草窗",
      "resolution": "并列的南宋词家是玉田，不是玉固。"
    },
    {
      "id": "renjian",
      "collection": "人间词话",
      "change": "沈著、沈雄 → 沉着、沉雄",
      "resolution": "不是姓沈。姓沈的沈伯时不改。"
    },
    {
      "id": "v06-15",
      "collection": "古文观止",
      "change": "費褘 → 費禕（简体袆 → 祎）",
      "resolution": "古文观止卷页把费祎写成衣字旁的褘。维基文库《前出師表》作費禕。OpenCC 把褘收成袆，所以和卷页缓存逐字比较看不出错。正文改从《前出師表》。"
    },
    {
      "id": "v06-15",
      "collection": "古文观止",
      "change": "今天下三分、。 → 今天下三分、",
      "resolution": "夹注「蜀、吴、魏」删掉后，顿号和夹注外的句号粘在一起。这一句后面紧接益州，句号去掉。"
    },
    {
      "id": "v04-01",
      "collection": "古文观止",
      "change": "不可以高飛、。 → 不可以高飛、",
      "resolution": "夹注「此句是喻、起下三句」插在顿号和句号之间，删注后剩下「、。」。句号去掉，顿号仍作这一版本的逗号。"
    },
    {
      "id": "v05-06",
      "collection": "古文观止",
      "change": "简体干坤 → 乾坤",
      "resolution": "乾坤的乾读 qián。OpenCC 把所有乾收成干。干是干燥，这里改回乾。"
    },
    {
      "id": "v02-14",
      "collection": "古文观止",
      "change": "简体干谿 → 乾谿",
      "resolution": "地名乾谿读 qián。简体不写作干谿。"
    },
    {
      "id": "v04-17",
      "collection": "古文观止",
      "change": "简体流征 → 流徵",
      "resolution": "流徵是乐律，徵读 zhǐ，不简作征。"
    },
    {
      "id": "v03-06",
      "collection": "古文观止",
      "change": "禁罝䍡 → 禁罜䍡",
      "resolution": "卷页写成罝，夹注「作罜、音主」。罝读嗟，是兔网；这一处是小网。维基文库《里革斷罟匡君》作罜。前面禁罝罗仍是兔网，不改。"
    },
    {
      "id": "v07-19",
      "collection": "古文观止",
      "change": "简体祇辱 → 只辱",
      "resolution": "杂说四「祇辱于奴隶人之手」的祇是只、仅。神祇的祇不在此列，仍作祇。"
    }
