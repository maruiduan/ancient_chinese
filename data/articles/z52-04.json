,"level":"dict"},{"t":"親","s":"亲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楊","s":"杨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"震","s":"震","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諫","s":"谏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"龔","s":"龚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"止","s":"止","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"十二月乙亥日，顺帝从长安回到京城。","tokens":[{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乙","s":"乙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亥","s":"亥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"還","s":"还","py":"huán","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"永和二年，137年。武陵蛮围充城，太守李进击平之，又简选良吏抚循蛮夷，郡境遂安。山阳君宋娥与九侯相互贿赂，被收印绶。象林蛮区怜攻县寺，交趾、九真兵惮远役而反。顺帝幸长安。扶风法真隐居不仕，四征不屈。王龚欲奏诛中常侍张昉，被宗亲劝止。","theme":"本篇对照不同的治理方式。李进先「击叛蛮，破平之」，再「简选良吏，抚循蛮夷」，恩威并用，郡境才安。交趾刺史强征远役，「兵士惮远役」，反而激起兵变，「蛮势转盛」。法真「逃名而名我随」，与追逐爵禄的宋娥、九侯形成鲜明对照。","technique":"本篇写法真用侧面烘托。作者不正面写法真的言行，而借田弱的推荐和郭正的评价来表现：「法真名可得闻，身难得而见」，又用「逃名而名我随，避名而名我追」两句排比，写出法真越是逃名、名声越大，写人含蓄而传神。","keyContentWords":[{"word":"赂","reading":"lù","note":"贿赂。「坐与宋娥更相赂遗」。"},{"word":"惮","reading":"dàn","note":"害怕。「兵士惮远役」。"},{"word":"衮","reading":"gǔn","note":"衮职，指三公之位。「宜就加衮职」。"},{"word":"怜","reading":"lián","note":"区怜，人名。「象林蛮区怜等攻县寺」。"},{"word":"昉","reading":"fǎng","note":"张昉，人名。「以中常侍张昉等专弄国权」。"}],"keyFunctionWords":[{"word":"遗","reading":"wèi","note":"赠送。「坐与宋娥更相赂遗」。"},{"word":"更","reading":"gēng","note":"互相，交替。「坐与宋娥更相赂遗」。"},{"word":"长","reading":"zhǎng","note":"长官。「杀长吏」。"}],"ancientModern":[{"word":"县寺","note":"古义指县衙，寺指官署；今义寺指佛寺。「象林蛮区怜等攻县寺」。"},{"word":"内外学","note":"古义内学指谶纬之学，外学指儒家经学等；今义不用。「博通内外学」。"}],"phoneticLoans":[{"word":"区怜","note":"区、怜都是本字，区怜为人名，非通假。「象林蛮区怜等攻县寺」。"}],"flexibleUsage":[{"word":"名","note":"名声，名词作主语，与「随」「追」构成拟人。「逃名而名我随」。"}],"specialSyntax":[{"name":"宾语前置","note":"「逃名而名我随」，即“名随我”，宾语「我」前置。"},{"name":"判断句","note":"「真，雄之子也」，用「……，……也」表判断。"},{"name":"被动句","note":"「收印绶，归里舍」，意义上的被动，指宋娥被收印绶。"}]}}
