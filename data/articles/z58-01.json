py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"止","s":"止","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"大长秋、华容侯曹节去世；由中常侍赵忠接替兼任大长秋。","tokens":[{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秋","s":"秋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"華","s":"华","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"容","s":"容","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曹","s":"曹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"節","s":"节","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侍","s":"侍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忠","s":"忠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"代","s":"代","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"領","s":"领","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秋","s":"秋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"光和四年，181年。朝廷设𫘧骥厩丞征调马匹，马价暴涨。朱俊平定交趾梁龙之乱。鲜卑檀石槐死，其子和连、侄魁头相继为君，部众离散。灵帝在后宫开设集市，驾驴车驰逐，又广收私财。吕强上疏谏导行费和选举之弊，不被理会。何皇后毒杀王美人，几乎被废。","theme":"本篇着重写灵帝的荒嬉与贪财。「帝著商贾服，从之饮宴为乐」「驴价遂与马齐」，天子带头玩乐，京师竞相仿效；「先输中署」，把天下财物当作私产。吕强「岂有公私」一问，直指要害，又指出选举「责赏无归」的弊端，却「书奏，不省」。后宫何皇后「鸩杀美人」而得免，伏下后来皇子协与何氏的纠葛。","technique":"本篇善用白描。列肆、弄狗、驾驴三件事并列，不加评论，荒唐自见。吕强的奏疏层次分明：先论财无公私，再列中尚方、中御府、西园、中厩四处聚敛，排比整齐，最后以「岂肯空自劳苦乎」反问作结，气势有力。","keyContentWords":[{"word":"𫘧","reading":"lù","note":"𫘧骥，良马名，这里是厩名。「初置𫘧骥厩丞」。"},{"word":"榷","reading":"què","note":"专利，垄断。「豪右辜榷」。"},{"word":"浒","reading":"hǔ","note":"乌浒，南方部族名。「交趾乌浒蛮久为乱」。"},{"word":"戫","reading":"yù","note":"人名用字。「卫尉许戫为太尉」。"},{"word":"掖","reading":"yè","note":"掖庭，宫中旁舍。「北宫东掖庭永巷署灾」。"},{"word":"缯","reading":"zēng","note":"丝织品的总称。「中御府积天下之缯」。"},{"word":"谄","reading":"chǎn","note":"奉承，巴结。「容谄姑息」。"},{"word":"劾","reading":"hé","note":"检举揭发罪状。「然后付之尚书举劾」。"},{"word":"鸩","reading":"zhèn","note":"用毒酒杀人。「后鸩杀美人」。"}],"keyFunctionWords":[{"word":"岂","reading":"qǐ","note":"表反问，哪里。「岂有公私」。"},{"word":"而","reading":"ér","note":"表转折，却。「而所输之府」。"},{"word":"于","reading":"yú","note":"在。「帝作列肆于后宫」。"},{"word":"之","reading":"zhī","note":"代词，代马匹或人。「从之饮宴为乐」。"},{"word":"然","reading":"rán","note":"然而，但是。「然犹有旷职废官」。"}],"ancientModern":[{"word":"百姓","note":"古义多指平民；今义同。「百姓受其敝」。"},{"word":"姑息","note":"古义指迁就、苟安；今义指无原则地宽容。「容谄姑息」。"},{"word":"旧典","note":"古义指旧有的制度；今义多指古代典籍。「旧典：选举委任三府」。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"躬","note":"亲自，名词作状语。「帝躬自操辔」。"},{"word":"先","note":"先送，用在动词前作状语。「先输中署」。"}],"specialSyntax":[{"name":"省略句","note":"「诸中官固请，得止」省略了主语灵帝。"},{"name":"判断句","note":"「天下之财，莫不生之阴阳，归之陛下」用双重否定加强肯定。"},{"name":"反问句","note":"「岂肯空自劳苦乎」用「岂……乎」表反问。"}]}}
