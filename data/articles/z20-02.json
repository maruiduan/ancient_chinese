"py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"腹","s":"腹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誹","s":"诽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"比","s":"比","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卿","s":"卿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"多","s":"多","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諂","s":"谄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諛","s":"谀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"容","s":"容","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉武帝元狩六年，前117年。杨可告缗大兴，义纵因阻挠被处死。李敢击伤卫青，霍去病射杀李敢，武帝为之隐讳。册立三子为王。盗铸钱者被处死数十万人。霍去病去世，武帝为之起冢象祁连山；霍光随兄入长安。大农令颜异因「腹诽」被张汤论死。","theme":"本篇集中表现武帝时代法网的严密与任意。义纵阻挠告缗即被弃市；颜异仅「微反唇」，就被以「腹诽」论死，「自是之后，有腹诽之法比，而公卿大夫多谄谀取容矣」，揭示了酷法对士风的败坏。霍去病射杀李敢而武帝「为讳」，也可见宠臣与法律之间的关系。","technique":"作者叙颜异之死，先写其「廉直」，再写他直言「本末不相称」，然后一句「天子不说」，接着写张汤罗织罪名，因果分明。结尾以「腹诽之法比」点出影响，叙事简练而褒贬自见。","keyContentWords":[{"word":"告缗","reading":"gào mín","note":"告发隐匿财产、不如实交纳缗钱税的人。"},{"word":"废格","reading":"fèi gé","note":"搁置诏令，不予执行。"},{"word":"诰策","reading":"gào cè","note":"封王的诏书策文。"},{"word":"腹诽","reading":"fù fěi","note":"嘴上不说，心里反对。"},{"word":"取容","reading":"qǔ róng","note":"讨好别人以求容身。"}],"keyFunctionWords":[{"word":"其","reading":"qí","note":"代词，那些。「其不发觉者不可胜计」。"},{"word":"乃","reading":"nǎi","note":"才。「乃自知父为霍仲孺」。"},{"word":"以","reading":"yǐ","note":"用。「今王侯朝贺以苍璧」。"}],"ancientModern":[{"word":"无虑","note":"古义指大概、大致；今义指没有忧虑。"},{"word":"县官","note":"古义指朝廷、官府；今义指县的长官。"}],"phoneticLoans":[{"word":"说","note":"通“悦”，高兴。「天子不说」。"},{"word":"郤","note":"通“隙”，嫌隙。「张汤又与异有郤」。"}],"flexibleUsage":[{"word":"市","note":"「弃纵市」，名词作状语，在街市上。"},{"word":"冢","note":"「为冢，像祁连山」，名词用作动词，修建坟墓。"}],"specialSyntax":[{"name":"被动句","note":"「大农令颜异诛」，意念被动，颜异被诛杀。"},{"name":"省略句","note":"「下张汤治异」，省略主语「上」，意为武帝把案子交给张汤审理。"}]}}
