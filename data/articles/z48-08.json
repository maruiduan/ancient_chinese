:"本篇只有一道奏疏，层次清楚：先说说经不得相让，用「规矩权衡之不可枉」作比喻；再说辩论的方法；最后说兼容不同师法。语言整齐，多用对偶句。","keyContentWords":[{"word":"丕","reading":"pī","note":"鲁丕，人名。「使中大夫鲁丕与侍中贾逵」。"},{"word":"刍荛","reading":"chú ráo","note":"割草打柴的人，指平民。「无令刍荛以言得罪」。"},{"word":"难","reading":"nàn","note":"辩难，质问。「相难数事」。"}],"keyFunctionWords":[{"word":"因","reading":"yīn","note":"趁着。「帝因朝会」。"},{"word":"务","reading":"wù","note":"务必。「说者务立其义」。"},{"word":"愈","reading":"yù","note":"越发。「而道术愈章」。"}],"ancientModern":[{"word":"规矩","note":"古义指圆规和曲尺；今义指规则。「若规矩权衡之不可枉也」。"},{"word":"浮华","note":"古义指虚浮不实；今义同。「浮华无用之言」。"}],"phoneticLoans":[{"word":"章","note":"同“彰”，明显。「而道术愈章」。"}],"flexibleUsage":[{"word":"善","note":"形容词意动用法，以……为善。「帝善丕说」。"}],"specialSyntax":[{"name":"判断句","note":"「非从己出」，用「非」表否定判断。"},{"name":"比喻句","note":"「若规矩权衡之不可枉也」，以规矩作比。"},{"name":"省略句","note":"「罢朝，特赐衣冠」，省略主语和帝。"}]}}
