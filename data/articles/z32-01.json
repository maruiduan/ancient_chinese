ibleUsage":[{"word":"讳","note":"「《春秋》为亲者讳」，动词，隐讳。"},{"word":"思","note":"「去后常见思」，动词，思念。"}],"specialSyntax":[{"name":"被动句","note":"「去后常见思」，用「见」表被动。"},{"name":"判断句","note":"「萌牙之时，加恩勿治，上也」，用「……也」表判断。"}]}}
