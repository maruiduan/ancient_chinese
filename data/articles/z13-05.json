s":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"开始规定戍守边疆的士卒每年轮换一次。","tokens":[{"t":"初","s":"初","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戍","s":"戍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歲","s":"岁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"更","s":"更","py":"gēng","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉高后五年，前183年。赵佗自称南越武帝，发兵攻打长沙国，攻破几个县后离去。淮阳王刘强去世，壶关侯刘武继为淮阳王。调河东、上党骑兵屯驻北地。开始规定戍卒每年轮换。","theme":"赵佗称帝是对汉朝的公开挑战，起因正是上一年的禁关市。北方匈奴的威胁也没有消除，所以朝廷在北地屯兵，并改革戍边制度，使士卒一年一换。","technique":"全年四句，南、北两方的边事和诸侯王的更替交错记载，看似平淡，却反映了汉初南北两面受压的局势。","keyContentWords":[{"word":"屯","reading":"tún","note":"驻扎。「骑屯北地」。"},{"word":"戍卒","reading":"shù zú","note":"戍守边疆的士兵。"},{"word":"岁更","reading":"suì gēng","note":"每年轮换一次。"}],"keyFunctionWords":[{"word":"初","reading":"chū","note":"「初令戍卒岁更」，副词，开始、第一次。"}],"ancientModern":[{"word":"武帝","note":"这里是赵佗自封的帝号，不是汉武帝。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"岁","note":"「岁更」，名词用作状语，每年。"},{"word":"帝","note":"「自称南越武帝」，帝是名词，作称的宾语。"}],"specialSyntax":[{"name":"省略句","note":"「败数县而去」，省略主语赵佗。"}]}}
