icLoans":[],"flexibleUsage":[{"word":"雨","note":"「夏，四月，雨雹」，名词用作动词，下，读 yù。"},{"word":"食","note":"「人相食」，动词，吃。"}],"specialSyntax":[{"name":"省略句","note":"「坐宪王病不侍疾」，省略主语「勃」。"}]}}
