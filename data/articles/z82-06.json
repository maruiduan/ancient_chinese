":[{"word":"货赂","reading":"huò lù","note":"用财物买通。「货赂流行，所宜深绝」。"},{"word":"大棘城","reading":"dà jí chéng","note":"慕容部这一年迁到的地方，在棘城。「徙居大棘城」。"},{"word":"长吏","reading":"zhǎng lì","note":"地方长官。长读 zhǎng。「杀长吏」。"}],"keyFunctionWords":[{"word":"初","reading":"chū","note":"刚开始。「初为司隶校尉」。"},{"word":"所","reading":"suǒ","note":"应当做的事。「所宜深绝」。"}],"ancientModern":[{"word":"风格","note":"这里是风度和品格，不是文艺流派。「风格峻整」。"},{"word":"肃然","note":"这里是敬畏收敛，不是寂寞。「京师肃然」。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"绝","note":"禁绝。「所宜深绝」。"}],"specialSyntax":[{"name":"判断与描写","note":"「咸性刚简，风格峻整」先写性情，再写做事的样子。"}]}}
