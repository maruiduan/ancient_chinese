":"」","punct":true}]},{"tr":"文帝听到后，心里为此感到难过。","tokens":[{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"病","s":"病","py":"bìng","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉文帝前七年，前173年。下令列侯的母亲、妻子、诸侯王子及二千石官吏不得擅自征捕人。四月大赦天下。未央宫东阙的罘罳失火。民间流传歌谣讽刺文帝逼死淮南王，文帝听后很难过。","theme":"这一年事少，但「兄弟二人不相容」的歌谣很有分量：淮南王虽有罪，民间却把他的死看作兄弟相残，文帝因此内疚，引出下一年封淮南王诸子为列侯的事。","technique":"全年只有五句，前三句是诏令和灾异的简要记录，后面用一首民谣收尾。民谣以布、粟作比，三句押韵，朴素易懂，用百姓的声音代替史家的评论。","keyContentWords":[{"word":"罘罳","reading":"fú sī","note":"宫门外或城角上的网状屏障。"},{"word":"太夫人","reading":"tài fū rén","note":"列侯的母亲。"},{"word":"征捕","reading":"zhēng bǔ","note":"征召、逮捕。"}],"keyFunctionWords":[{"word":"尚","reading":"shàng","note":"「尚可缝」「尚可舂」，还、尚且。"},{"word":"而","reading":"ér","note":"「帝闻而病之」，连词，表承接。"}],"ancientModern":[{"word":"病","note":"「帝闻而病之」，忧虑、难过，不是生病。"},{"word":"灾","note":"「东阙罘罳灾」，指火灾。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"病","note":"「帝闻而病之」，形容词意动用法，以……为忧。"}],"specialSyntax":[{"name":"省略句","note":"「帝闻而病之」，省略宾语，即听到这首歌谣。"}]}}
