,{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"八","s":"八","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"这一年，十五个郡国发生地震。","tokens":[{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歲","s":"岁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"震","s":"震","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"元初元年，114年。改元元初。日南地裂，又有日食。朝廷在河内要道修建坞壁三十三处防备羌人。先零羌进犯雍城，羌豪号多抢掠武都、汉中、巴郡，被程信和板楯蛮击破，又被侯霸、马贤打败。凉州刺史皮杨在狄道大败。","theme":"本篇写羌乱的蔓延。羌人从雍城到武都、汉中、巴郡，范围广大，朝廷只能「皆为坞壁，设鸣鼓」被动防守。程信联合板楯蛮获胜，说明借助当地力量的重要；皮杨「大败，死者八百余人」，则显出官军战力的不足。","technique":"本篇以时间为序，胜败交替叙述，号多「走还，断陇道，与零昌合」几个动作连续，写出羌人的机动。结尾以皮杨大败和地震收束，气氛沉重。","keyContentWords":[{"word":"坼","reading":"chè","note":"裂开。「日南地坼」。"},{"word":"坞","reading":"wù","note":"小城堡。「皆为坞壁」。"},{"word":"楯","reading":"dùn","note":"盾牌，板楯蛮为部族名。「板楯蛮救之」。"},{"word":"枹罕","reading":"fú hǎn","note":"县名。「侯霸、马贤与战于枹罕」。"},{"word":"苞","reading":"bāo","note":"司马苞，人名。「以大司农山阳司马苞为太尉」。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"用来。「以备羌寇」。"},{"word":"与","reading":"yǔ","note":"和。「与零昌合」。"},{"word":"共","reading":"gòng","note":"一起。「率郡兵与蛮共击破之」。"}],"ancientModern":[{"word":"改元","note":"古义指更改年号；今义同。「改元」。"},{"word":"冲要","note":"古义指交通要道；今义少用。「诏遣兵屯河内通谷冲要三十三所」。"}],"phoneticLoans":[{"word":"钞","note":"同“抄”，抢夺。「羌豪号多与诸种钞掠武都、汉中、巴郡」。"}],"flexibleUsage":[{"word":"坞壁","note":"名词作动词，修筑坞壁。「皆为坞壁」。"}],"specialSyntax":[{"name":"状语后置","note":"「击羌于狄道」，介宾短语后置。"},{"name":"省略句","note":"「破之」，省略主语侯霸、马贤。"},{"name":"判断句","note":"「死者八百余人」，叙述结果。"}]}}
