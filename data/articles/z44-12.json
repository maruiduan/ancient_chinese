eUsage":[{"word":"前","note":"方位名词作动词，上前。「以次前」。"},{"word":"厚","note":"形容词作状语，隆重地。「不欲厚葬以违其意」。"}],"specialSyntax":[{"name":"判断句","note":"「息政，小人也」，以「也」表判断。"},{"name":"省略句","note":"「戊寅，强薨」，以干支纪日领起。"},{"name":"叠句","note":"「诚悲诚惭」，加强情感。"}]}}
