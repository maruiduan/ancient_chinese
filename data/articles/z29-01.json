":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"恢复设置盐铁官；设置博士弟子名额一千人。","tokens":[{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鹽","s":"盐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鐵","s":"铁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"官","s":"官","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"置","s":"置","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"博","s":"博","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弟","s":"弟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"員","s":"员","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这是因为国家用度不足，百姓中很多人被免除了徭役，无法供给朝廷内外的徭役的缘故。","tokens":[{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"度","s":"度","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"多","s":"多","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"除","s":"除","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"給","s":"给","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"外","s":"外","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"繇","s":"繇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"役","s":"役","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉元帝永光三年，前41年。冯奉世平定陇西羌人后回京，改任左将军，赐爵关内侯。许嘉任大司马、车骑将军。因为国家用度不足，朝廷恢复了盐铁官，又设置博士弟子一千人。","theme":"本篇篇幅短小，但反映了元帝朝财政的困境。初元五年刚刚罢盐铁官，此时又「复盐铁官」，原因是「用度不足，民多复除，无以给中外繇役」。可见元帝的节俭改革缺乏长远规划，政策反复，正如匡衡后来批评的那样，所更改的政策有的行不通又恢复。","technique":"本篇先按时间顺序罗列时事，最后一句用「……故也」交代复盐铁官的原因，以简驭繁，因果分明，读来条理清楚。","keyContentWords":[{"word":"复除","reading":"fù chú","note":"免除徭役赋税。"},{"word":"繇役","reading":"yáo yì","note":"徭役。"},{"word":"雨水","reading":"yù shuǐ","note":"下大雨。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"因为。「以用度不足」。"},{"word":"故","reading":"gù","note":"缘故。「无以给中外繇役故也」。"}],"ancientModern":[{"word":"用度","note":"古义指国家的开支；今义指一般的费用。「以用度不足」。"}],"phoneticLoans":[{"word":"繇","note":"通“徭”。「无以给中外繇役故也」。"}],"flexibleUsage":[{"word":"雨","note":"「地震，雨水」，名词用作动词，下雨，读 yù。"}],"specialSyntax":[{"name":"判断句","note":"「以用度不足……故也」，用「……故也」表原因判断。"}]}}
