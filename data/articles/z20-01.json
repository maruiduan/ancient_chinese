eading":"jí","note":"等到。「及汤败」。"}],"ancientModern":[{"word":"下吏","note":"古义指交给司法官吏审讯；今义指下级官吏。"},{"word":"不意","note":"古义指没想到；今义多指不在意。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"薄","note":"「君薄淮阳邪」，形容词意动用法，认为……微薄，看不起。"},{"word":"卧","note":"「卧而治之」，动词作状语，躺着。"}],"specialSyntax":[{"name":"判断句","note":"「补过拾遗，臣之愿也」，用「……也」表判断。"},{"name":"反问句","note":"「义纵以我为不复行此道乎」，用「以……为……乎」表反问。"}]}}
