","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"答","s":"答","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"永元十六年，104年。发生旱灾，三公频繁更换，徐防升任司徒，陈宠任司空。和帝登百岯山。北匈奴遣使称臣求和亲，和帝因礼数不备没有答应，只给予厚赏。","theme":"本篇体现汉朝对北匈奴的态度。北匈奴「愿和亲，修呼韩邪故约」，和帝以「其旧礼不备」为由不许，却「厚加赏赐」，既保持大国体面，又安抚对方，显示出汉朝强盛时期的外交姿态。","technique":"本篇几乎全是简短记事，人事更替一句一事，节奏紧凑。结尾北匈奴求和一段，用「未许」「厚加赏赐」「不答其使」三层写出汉朝的处置，简洁而有分寸。","keyContentWords":[{"word":"缑","reading":"gōu","note":"缑氏，县名。「帝行幸缑氏」。"},{"word":"岯","reading":"pī","note":"百岯山，山名。「登百岯山」。"},{"word":"胪","reading":"lú","note":"大鸿胪，官名。「大鸿胪陈宠为司空」。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"因为。「帝以其旧礼不备」。"},{"word":"而","reading":"ér","note":"但是。「而厚加赏赐」。"},{"word":"修","reading":"xiū","note":"恢复。「修呼韩邪故约」。"}],"ancientModern":[{"word":"和亲","note":"古义指与外族讲和结亲；今义同。「愿和亲」。"},{"word":"称臣","note":"古义指向对方表示臣服；今义同。「北匈奴遣使称臣贡献」。"}],"phoneticLoans":[{"word":"答","note":"回报，回派使者。「不答其使」。"}],"flexibleUsage":[{"word":"厚","note":"形容词作状语，丰厚地。「而厚加赏赐」。"}],"specialSyntax":[{"name":"省略句","note":"「未许」，省略主语和帝。"},{"name":"固定句式","note":"「以司空徐防为司徒」，以……为……表任命。"},{"name":"省略句","note":"「不答其使」，省略主语和帝。"}]}}
