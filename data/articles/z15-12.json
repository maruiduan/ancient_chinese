ord":"耶","reading":"yé","note":"「可得而犯耶」，语气词，表反问。"}],"ancientModern":[{"word":"先驱","note":"天子出行时在前面开路的人，与今天说的先驱者不同。"},{"word":"儿戏","note":"像小孩子游戏一样，比喻不严肃，今天仍用。"}],"phoneticLoans":[{"word":"振","note":"「发仓庾以振民」的振通赈，救济。"},{"word":"式","note":"「式车」的式通轼。"}],"flexibleUsage":[{"word":"劳","note":"「上自劳军」，读 lào，慰劳。"},{"word":"锐","note":"「锐兵刃」，形容词使动用法，使……锋利。"}],"specialSyntax":[{"name":"被动句","note":"「其将固可袭而虏也」，意念被动，可以被袭击俘虏。"}]}}
