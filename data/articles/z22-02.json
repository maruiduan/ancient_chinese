":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"單","s":"单","py":"chán","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"左","s":"左","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"右","s":"右","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"陵","s":"陵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"居","s":"居","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"外","s":"外","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"議","s":"议","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"夏季，四月，立皇子刘髆为昌邑王。","tokens":[{"t":"夏","s":"夏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皇","s":"皇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"髆","s":"髆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昌","s":"昌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邑","s":"邑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉武帝天汉四年，前97年。武帝发七科谪，命李广利、路博德、韩说、公孙敖四路出击匈奴，均无功而返。公孙敖误传李陵教单于练兵，武帝族灭李陵全家，后来才知道是降将李绪。单于以女妻李陵，立为右校王。立皇子刘髆为昌邑王。","theme":"本篇写李陵悲剧的完成。一句未经核实的传言，使武帝「族陵家」，等到「既而闻之，乃汉将降匈奴者李绪，非陵也」，已经无法挽回。李陵「使人刺杀绪」，又被单于尊用，从此彻底留在匈奴。作者只叙事实，不加评论，而武帝的轻率与李陵的不幸都在其中。","technique":"四路出师写得整齐，各用「将……出……」的句式，而结局只用「引归」「无所得」「不利」几个字概括，大起大落。「上于是族陵家」与「既而闻之」紧接，前后对照，令人叹惋。","keyContentWords":[{"word":"七科谪","reading":"qī kē zhé","note":"七种被贬谪的人，如有罪的官吏、赘婿、商人等。"},{"word":"累重","reading":"lěi zhòng","note":"家属和辎重。"},{"word":"生口","reading":"shēng kǒu","note":"俘虏。"},{"word":"用事","reading":"yòng shì","note":"掌权。"}],"keyFunctionWords":[{"word":"悉","reading":"xī","note":"全部。「悉远其累重于余吾水北」。"},{"word":"既而","reading":"jì ér","note":"不久。「既而闻之」。"},{"word":"乃","reading":"nǎi","note":"原来是。「乃汉将降匈奴者李绪」。"},{"word":"因","reading":"yīn","note":"于是，就。「因曰」。"}],"ancientModern":[{"word":"勇敢","note":"古义指勇敢的士卒，作名词；今义是形容词。「发天下七科谪及勇敢士」。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"远","note":"「悉远其累重于余吾水北」，形容词用作动词，使……远离，远迁。"},{"word":"族","note":"「上于是族陵家」，名词用作动词，灭族。"},{"word":"妻","note":"「单于以女妻陵」，名词用作动词，嫁给，读 qì。"},{"word":"贵","note":"「与卫律皆贵用事」，形容词，地位显贵。"}],"specialSyntax":[{"name":"判断句","note":"「乃汉将降匈奴者李绪，非陵也」，用「乃……非……也」表判断。"},{"name":"定语后置","note":"「汉将降匈奴者李绪」，即“降匈奴的汉将李绪”。"}]}}
