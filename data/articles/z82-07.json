ontentWords":[{"word":"武库","reading":"wǔ kù","note":"存放兵器和宝物的库。「武库火」。"},{"word":"濡源","reading":"ruǎn yuán","note":"濡水的上游。濡在这条水名里读 ruǎn。「濡源之西」。"},{"word":"参合陂","reading":"cān hé bēi","note":"在代郡。「代郡参合陂之北」。"},{"word":"盛乐","reading":"shèng lè","note":"定襄的旧城，猗卢所居。「盛乐故城」。"}],"keyFunctionWords":[{"word":"使","reading":"shǐ","note":"让。「使兄沙漠汗之子猗㐌统之」。"},{"word":"皆","reading":"jiē","note":"都。「皆破之」。"},{"word":"稍","reading":"shāo","note":"渐渐。「晋人附者稍众」。"},{"word":"自","reading":"zì","note":"自己。「自统之」。"}],"ancientModern":[{"word":"器械","note":"这里是兵器军需，不是一般器具。「二百万人器械」。"},{"word":"国事","note":"这里是本部的政事。「任以国事」。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"说","note":"劝说。读 shuì。「说猗㐌、猗卢招纳晋人」。"},{"word":"调","note":"征调。「大调兵器」。"}],"specialSyntax":[{"name":"并列分述","note":"「一居……自统之；一居……使……统之；一居……使……统之」把三部分开写。"}]}}
