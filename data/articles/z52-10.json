"s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"科","s":"科","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉安二年，143年。赵冲在参䜌、阿阳击破烧当羌。立兜楼储为南匈奴单于，顺帝亲授玺绶，诏太常等祖会于广阳城门外。马寔遣人刺杀吾斯。凉州地震一百八十次。尚书令黄琼奏增孝悌及能从政者，与儒学、文吏合为四科。","theme":"本篇写朝廷对边疆的经营与选士制度的调整。对南匈奴，朝廷一面隆重册立新单于，「赐车马、器服、金帛甚厚」，以恩结之；一面刺杀叛首吾斯，以威制之。黄琼认为只取儒学、文吏「于取士之义犹有所遗」，增加孝悌、从政两科，使选拔人才更全面。","technique":"本篇篇幅短小，按时间顺序记事。写册立单于，连用「临轩授玺绶」「引上殿」「赐车马」「祖会」「飨赐、作乐、角抵、百戏」，铺排场面，显出礼遇之隆。","keyContentWords":[{"word":"䜌","reading":"luán","note":"参䜌，县名。「击烧当羌于参䜌」。"},{"word":"寔","reading":"shí","note":"马寔，人名。「使匈奴中郎将扶风马寔」。"},{"word":"坼","reading":"chè","note":"裂开。「山谷坼裂」。"},{"word":"飨","reading":"xiǎng","note":"用酒食款待。「飨赐、作乐」。"},{"word":"抵","reading":"dǐ","note":"角抵，一种角力游戏。「角抵、百戏」。"}],"keyFunctionWords":[{"word":"轩","reading":"xuān","note":"殿前的平台。「上亲临轩授玺绶」。"},{"word":"单","reading":"chán","note":"单于，匈奴君主的称号。「立南匈奴守义王兜楼储为呼兰若尸逐就单于」。"},{"word":"从","reading":"cóng","note":"从事。「乃奏增孝悌及能从政者为四科」。"}],"ancientModern":[{"word":"祖会","note":"古义指设宴饯行；今义不用。「于广阳城门外祖会」。"},{"word":"百戏","note":"古义指各种杂技乐舞的总称；今义少用。「角抵、百戏」。"}],"phoneticLoans":[{"word":"悌","note":"孝悌之悌本义敬爱兄长，非通假。「乃奏增孝悌及能从政者为四科」。"}],"flexibleUsage":[{"word":"祖","note":"设宴饯行，名词作动词。「于广阳城门外祖会」。"}],"specialSyntax":[{"name":"省略句","note":"「引上殿」，省略宾语兜楼储。"},{"name":"状语后置","note":"「击烧当羌于参䜌」，介宾短语后置。"},{"name":"定语后置","note":"「民压死者甚众」，「压死者」修饰「民」，构成定语后置。"}]}}
