d":"繇是","reading":"yóu shì","note":"从此。「繇是不疑名声重于朝廷」。"},{"word":"比","reading":"bǐ","note":"接连。「年岁比不登」。"}],"ancientModern":[{"word":"是非","note":"古义此处指真假；今义多指对错。「是非未可知」。"}],"phoneticLoans":[{"word":"距","note":"通“拒”，拒绝。「辄距而不纳」。"},{"word":"谊","note":"通“义”。「明于大谊者」。"},{"word":"繇","note":"通“由”。「繇是」。"},{"word":"说","note":"通“悦”，使……喜悦。「说民意」。"}],"flexibleUsage":[{"word":"是","note":"「《春秋》是之」，形容词意动用法，认为……对。"},{"word":"嘉","note":"「闻而嘉之」，形容词意动用法，赞许。"},{"word":"利","note":"「方遂心利其言」，形容词意动用法，认为……有利。"}],"specialSyntax":[{"name":"判断句","note":"「此罪人也」，用「此……也」表判断。"},{"name":"被动句","note":"「坐诬罔不道，要斩」，意念被动。"}]}}
