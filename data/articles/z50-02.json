e":"袁敞，人名。「司空袁敞」。"},{"word":"秩","reading":"zhì","note":"于秩居，人名。「乌桓大人于秩居等共击」。"},{"word":"敛","reading":"liǎn","note":"征收。「以郡县赋敛烦数」。"},{"word":"数","reading":"shuò","note":"频繁。「以郡县赋敛烦数」。"},{"word":"虔","reading":"qián","note":"虔人，羌部落名。「于是西河虔人种羌万人诣邓遵降」。"}],"keyFunctionWords":[{"word":"坐","reading":"zuò","note":"因……获罪。「敞坐策免」。"},{"word":"稍稍","reading":"shāo shāo","note":"渐渐。「稍稍降散」。"},{"word":"于是","reading":"yú shì","note":"从此，因此。「于是西河虔人种羌万人诣邓遵降」。"}],"ancientModern":[{"word":"怨家","note":"古义指仇家；今义少用。「怨家封上之」。"},{"word":"自讼","note":"古义指为自己申辩；今义无此用法。「俊上书自讼」。"}],"phoneticLoans":[{"word":"效","note":"同“効”。「复募效功种羌号封」。"}],"flexibleUsage":[{"word":"封","note":"名词作动词，封好、加封。「怨家封上之」。"},{"word":"论","note":"动词，判罪。「太后诏以减死论」。"}],"specialSyntax":[{"name":"被动句","note":"「征抵罪」，意念被动，指尹就被征召回京判罪。"},{"name":"状语后置","note":"「战于富平河上」，介宾短语后置。"},{"name":"省略句","note":"「封号封为羌王」，省略主语朝廷。"}]}}
