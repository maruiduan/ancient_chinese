"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"十二月，武帝前往雍县，祭祀五畤。","tokens":[{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幸","s":"幸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雍","s":"雍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"祠","s":"祠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"畤","s":"畤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"向西到达安定、北地。","tokens":[{"t":"西","s":"西","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"定","s":"定","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉武帝太始四年，前93年。武帝到泰山，在明堂祭祀高祖以配上帝，又祀孝景皇帝，修封，禅石闾。返回建章宫，大赦天下。十月月末日食。十二月到雍县祭祀五畤，西至安定、北地。","theme":"本篇全是记事，按日期排列武帝的祭祀和巡游活动。从「壬午」「癸未」「甲申」「丙戌」连续几天的祭典，可见封禅大典的隆重。这类编年记事体现了《资治通鉴》按年月日记事的体例。","technique":"全篇用干支纪日，句子短促，「甲申，修封」「丙戌，禅石闾」，四五字一句，节奏紧凑，这是编年体史书的典型笔法。","keyContentWords":[{"word":"配","reading":"pèi","note":"配享，附带受祭。"},{"word":"修封","reading":"xiū fēng","note":"重新举行封礼。"},{"word":"禅","reading":"shàn","note":"祭地之礼。"},{"word":"晦","reading":"huì","note":"农历每月最后一天。"},{"word":"五畤","reading":"wǔ zhì","note":"雍县祭祀五帝的祭坛。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"来，表目的。「祀高祖于明堂以配上帝」。"},{"word":"因","reading":"yīn","note":"趁机。「因受计」。"},{"word":"之","reading":"zhī","note":"代词，指太阳。「日有食之」。"}],"ancientModern":[{"word":"食","note":"古义此处指日食的“蚀”；今义指吃。「日有食之」。"}],"phoneticLoans":[{"word":"食","note":"通“蚀”，亏蚀。「日有食之」。"}],"flexibleUsage":[{"word":"禅","note":"「禅石闾」，动词，在石闾山祭地，读 shàn。"},{"word":"西","note":"「西至安定、北地」，方位名词作状语，向西。"}],"specialSyntax":[{"name":"状语后置","note":"「祀孝景皇帝于明堂」，介宾短语「于明堂」后置。"}]}}
