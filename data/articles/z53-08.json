ding":"zhí","note":"盗跖，古代大盗。「化为桀、跖」。"},{"word":"黥","reading":"qíng","note":"在脸上刺字的刑罚。「臣愿黥首系趾」。"}],"keyFunctionWords":[{"word":"恶","reading":"wù","note":"厌恶。「非恶荣而好辱」。"},{"word":"好","reading":"hào","note":"喜欢。「恶生而好死也」。"},{"word":"校","reading":"jiào","note":"左校，官署名，掌管土木工程的刑徒。「输作左校」。"}],"ancientModern":[{"word":"左校","note":"古义指官署名；今义不用。「输作左校」。"},{"word":"宦者","note":"古义指宦官；今义不用。「宦者赵忠丧父」。"}],"phoneticLoans":[{"word":"刑谪","note":"此处「谪」为惩罚之意，非通假。「极其刑谪」。"}],"flexibleUsage":[{"word":"黥","note":"在脸上刺字，刑名作动词。「臣愿黥首系趾」。"}],"specialSyntax":[{"name":"状语后置","note":"「富于季孙」，介宾短语「于季孙」后置，表比较。"},{"name":"判断句","note":"「非恶荣而好辱，恶生而好死也」，用「非……也」表否定判断。"},{"name":"对偶","note":"「手握王爵，口衔天宪」，对偶工整。"}]}}
