"ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"別","s":"别","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"居","s":"居","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丁","s":"丁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奚","s":"奚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"永初六年，112年。邓太后下诏，供奉宗庙和御用的食物必须合乎时令，停止进献反季节的食物。刘恺任司空。诏令建武功臣后代继承封爵，百官恢复俸禄。滇零死，其子零昌即位，杜季贡为将军。","theme":"本篇最有意义的是邓太后的诏书。她批评「郁养强孰，或穿掘萌牙」的做法违背自然，引用「非其时不食」，主张「皆须时乃上」，体现了顺应天时、爱惜物力的思想，一次就省去二十三种。","technique":"本篇以诏书开头，诏书先描述弊端，再用反问「岂所以顺时育物乎」点明错误，最后引经据典，提出规定，层次清楚。后面的记事简洁，以滇零之死和零昌即位收尾，为下文羌事作铺垫。","keyContentWords":[{"word":"郁","reading":"yù","note":"温暖，这里指在温室中培育。「或郁养强孰」。"},{"word":"萌","reading":"méng","note":"草木的芽。「或穿掘萌牙」。"},{"word":"恺","reading":"kǎi","note":"刘恺，人名。「以太常刘恺为司空」。"},{"word":"谿","reading":"xī","note":"山谷，此处为地名用字。「豫章员谿原山崩」。"}],"keyFunctionWords":[{"word":"凡","reading":"fán","note":"凡是。「凡供荐新味」。"},{"word":"岂","reading":"qǐ","note":"难道。「岂所以顺时育物乎」。"},{"word":"须","reading":"xū","note":"等待。「皆须时乃上」。"}],"ancientModern":[{"word":"一切","note":"古义指一律；今义指全部。「一切复秩」。"},{"word":"将军","note":"古义指武官名；今义同。「以季贡为将军」。"}],"phoneticLoans":[{"word":"孰","note":"同“熟”。「或郁养强孰」。"},{"word":"牙","note":"同“芽”。「或穿掘萌牙」。"}],"flexibleUsage":[{"word":"强","note":"形容词作状语，勉强地。「或郁养强孰」。"}],"specialSyntax":[{"name":"反问句","note":"「岂所以顺时育物乎」，用「岂……乎」表反问。"},{"name":"判断句","note":"「非其时不食」，用「非」表否定条件。"},{"name":"省略句","note":"「凡所省二十三种」，省略主语。"}]}}
