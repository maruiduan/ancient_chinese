tx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侍","s":"侍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"封","s":"封","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諝","s":"谞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"徐","s":"徐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奉","s":"奉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"等","s":"等","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"內","s":"内","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"應","s":"应","py":"yìng","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"約","s":"约","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"內","s":"内","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"外","s":"外","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"俱","s":"俱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"起","s":"起","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"光和六年，183年。大旱，金城河水泛滥，五原山岸崩塌。巨鹿张角创立太平道，以符水治病，十余年间徒众数十万，遍及八州。杨赐、刘陶先后上书建议及早处置，灵帝都不在意。张角设三十六方，散布「苍天已死，黄天当立」的谶语，马元义勾结宦官封谞、徐奉，约定三月五日起事。","theme":"本篇写黄巾起义的酝酿。张角以「呪符水以疗病」聚众，「徒众数十万」，而「郡县不解其意，反言角以善道教化」。杨赐提出「简别流民，各护归本郡，以孤弱其党」的稳妥办法，刘陶则指出「州郡忌讳，不欲闻之」，但灵帝「殊不为意，方诏陶次第春秋条例」，在危机面前只管修书，昏聩可见。结尾写宦官为内应，暗示宫廷腐败与民变已经勾连。","technique":"本篇层层蓄势：先写天灾，再写道术流行，再写大臣的警告被搁置，最后写起事的组织和日期，紧张感逐步加强。「苍天已死，黄天当立，岁在甲子，天下大吉」四句谶语短促有力，是全篇的高潮。","keyContentWords":[{"word":"呪","reading":"zhòu","note":"同咒，念咒。「呪符水以疗病」。"},{"word":"诳","reading":"kuáng","note":"欺骗。「转相诳诱」。"},{"word":"兖","reading":"yǎn","note":"兖州。「兖、豫八州之人」。"},{"word":"蔓","reading":"màn","note":"蔓延。「稍益滋蔓」。"},{"word":"觇","reading":"chān","note":"窥视。「觇视朝政」。"},{"word":"讹","reading":"é","note":"谣言。「讹言」。"},{"word":"谞","reading":"xū","note":"人名用字。「以中常侍封谞、徐奉等为内应」。"},{"word":"邺","reading":"yè","note":"地名。「期会发于邺」。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"用。「以妖术教授」。"},{"word":"而","reading":"ér","note":"表顺承。「众共神而信之」。"},{"word":"反","reading":"fǎn","note":"反而。「反言角以善道教化」。"},{"word":"遂","reading":"suì","note":"于是，就。「事遂留中」。"},{"word":"犹","reading":"yóu","note":"如同。「方犹将军也」。"}],"ancientModern":[{"word":"教授","note":"古义指传授；今义多指高校的职称。「以妖术教授」。"},{"word":"公文","note":"古义指官府的正式文书，「公文」上报；今义同而用法更宽。「莫肯公文」。"},{"word":"留中","note":"古义指奏章留在宫中不下发；今无此用法。「事遂留中」。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"神","note":"把……当作神，名词作动词。「众共神而信之」。"},{"word":"公文","note":"用公文上报，名词作动词。「莫肯公文」。"},{"word":"孤弱","note":"使……孤立削弱，形容词使动。「以孤弱其党」。"}],"specialSyntax":[{"name":"判断句","note":"「方犹将军也」以「犹……也」表判断。"},{"name":"被动句","note":"「为民所归」用「为……所」表被动。"},{"name":"省略句","note":"「以白土书京城寺门」省略了主语张角之徒。"}]}}
