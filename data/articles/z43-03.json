tra":"","level":"dict"},{"t":"報","s":"报","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"建武十四年，38年。邛谷王任贵上计，授越巂太守。西域苦匈奴重敛，请复置都护，光武不许。梁统上疏请恢复旧律，认为轻刑导致「人轻犯法，吏易杀人」；杜林反对，主张宽缓；梁统再奏，事寝不报。","theme":"本篇是一场关于刑罚轻重的论辩。梁统主张「刑罚在衷，无取于轻」，认为「刑轻之作，反生大患，惠加奸轨，而害及良善」；杜林则认为法令苛密只会「上下相遁，为敝弥深」。两种观点各有道理，反映了儒家中道思想在法制上的运用。","technique":"本篇以奏疏往复构成，梁统两疏引经据典、援古证今，杜林之奏简短有力。「衷之为言，不轻不重之谓也」，以训诂释义，是汉代奏疏的典型手法。","keyContentWords":[{"word":"巂","reading":"xī","note":"越巂，郡名。"},{"word":"鄯","reading":"shàn","note":"鄯善，国名。"},{"word":"蠲","reading":"juān","note":"免除。「蠲除苛政」。"},{"word":"茹","reading":"rú","note":"蔬菜。「果桃菜茹之馈」。"},{"word":"馈","reading":"kuì","note":"赠送。"},{"word":"遁","reading":"dùn","note":"逃避。「上下相遁」。"},{"word":"爰","reading":"yuán","note":"于是。「爰制百姓」。"},{"word":"轨","reading":"guǐ","note":"通“宄”，奸邪。「惠加奸轨」。"}],"keyFunctionWords":[{"word":"自是","reading":"zì shì","note":"从此。「自是以后」。"},{"word":"唯","reading":"wéi","note":"只。「文帝唯除省肉刑、相坐之法」。"},{"word":"则","reading":"zé","note":"那么。「则刑轻之作，反生大患」。"}],"ancientModern":[{"word":"常准","note":"古义指固定的标准；今义一般不用。「著为常准」。"},{"word":"穿凿","note":"古义指牵强附会；今义同。「轻为穿凿」。"}],"phoneticLoans":[{"word":"傅","note":"通“附”。「傅奏于左」。"},{"word":"衷","note":"通“中”，适中。「刑罚在衷」。"},{"word":"轨","note":"通“宄”。「惠加奸轨」。"}],"flexibleUsage":[{"word":"轻","note":"形容词作动词，减轻。「轻殊死刑三十四事」。"},{"word":"易","note":"形容词作状语，轻易。「吏易杀人」。"},{"word":"下","note":"动词，交给。「事下公卿」。"}],"specialSyntax":[{"name":"判断句","note":"「仁者爱人，义者正理」，以「……者……」表判断。"},{"name":"固定句式","note":"「衷之为言，不轻不重之谓也」，「……之谓」意为说的是。"},{"name":"省略句","note":"「事寝，不报」，省略主语。"}]}}
