,"extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"秋季，匈奴侵入雁门。","tokens":[{"t":"秋","s":"秋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"匈","s":"匈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奴","s":"奴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雁","s":"雁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"門","s":"门","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"雁门太守因畏敌怯懦被判罪，在街市斩首。","tokens":[{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"坐","s":"坐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"畏","s":"畏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愞","s":"愞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"棄","s":"弃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"市","s":"市","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉武帝天汉三年，前98年。开始实行酒类专卖。武帝再到泰山修封，方士求仙始终没有应验，武帝虽然厌倦，仍「羁縻不绝，冀遇其真」。夏天大旱，匈奴入雁门，太守因畏懦被处死。","theme":"本篇篇幅很短，重点在于武帝对方士的矛盾态度：「益怠厌方士之怪迂语」，却「犹羁縻不绝」。作者用「然其效可睹矣」一句冷静的评语，表明了对求仙活动的否定。榷酒酤则是武帝为解决财政困难推行的又一项专卖政策。","technique":"「然其效可睹矣」不直接下判断，只说效果可想而知，语气含蓄而讽意分明。前后两个「然犹」「然其」的转折，写出了武帝的执迷和求仙的徒劳。","keyContentWords":[{"word":"榷","reading":"què","note":"专卖。「初榷酒酤」。"},{"word":"受计","reading":"shòu jì","note":"接受郡国呈报的上计簿。"},{"word":"瘗","reading":"yì","note":"埋祭品于地下。"},{"word":"羁縻","reading":"jī mí","note":"笼络，维系。"},{"word":"畏愞","reading":"wèi nuò","note":"畏缩怯懦。"}],"keyFunctionWords":[{"word":"犹","reading":"yóu","note":"仍然。「而公孙卿犹以大人迹为解」。"},{"word":"益","reading":"yì","note":"更加。「天子益怠厌方士之怪迂语矣」。"},{"word":"弥","reading":"mí","note":"更加。「方士言神祠者弥众」。"},{"word":"冀","reading":"jì","note":"希望。「冀遇其真」。"}],"ancientModern":[{"word":"大人","note":"古义此处指巨人；今义指成年人或对长辈的敬称。「以大人迹为解」。"}],"phoneticLoans":[{"word":"愞","note":"通“懦”，怯懦。「太守坐畏愞弃市」。"}],"flexibleUsage":[{"word":"迂","note":"「怪迂语」，形容词，迂阔不切实际。"},{"word":"解","note":"「以大人迹为解」，名词，解释的理由。"}],"specialSyntax":[{"name":"被动句","note":"「太守坐畏愞弃市」，意念被动，被处死。"},{"name":"省略句","note":"「还，祠常山」，省略主语「上」。"}]}}
