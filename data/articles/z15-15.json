,"keyContentWords":[{"word":"傅","reading":"fù","note":"登记名籍，开始服役。「年二十始傅」。"},{"word":"请间","reading":"qǐng jiàn","note":"请求单独进见谈话。"},{"word":"堧垣","reading":"ruán yuán","note":"宫庙外空地的围墙。"},{"word":"复道","reading":"fù dào","note":"楼阁之间上下两层的通道。"}],"keyFunctionWords":[{"word":"辄","reading":"zhé","note":"「辄听」，总是、就。"},{"word":"且","reading":"qiě","note":"「府库金钱且百巨万」，将近。"},{"word":"乃","reading":"nǎi","note":"「乃外堧垣」，是、乃是。"}],"ancientModern":[{"word":"卖","note":"「为错所卖」，出卖、陷害，与今天的意思相近。"},{"word":"自绌","note":"「丞相嘉自绌所言不用」，自觉委屈，绌通屈。"}],"phoneticLoans":[{"word":"欧","note":"「因欧血而死」的欧通呕。"},{"word":"间","note":"「数请间言事」的间读 jiàn，空隙、单独。"}],"flexibleUsage":[{"word":"王","note":"「王四十余城」，读 wàng，名词用作动词，在……做王。"},{"word":"广","note":"「广睢阳城七十里」，形容词使动用法，扩大。"}],"specialSyntax":[{"name":"被动句","note":"「为错所卖」，为……所表被动。"},{"name":"判断句","note":"「南出者，太上皇庙堧垣也」，者……也表判断。"}]}}
