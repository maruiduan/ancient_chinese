","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"章帝天性笃厚仁爱，不忍心和诸王分离，于是都把他们留在京城。","tokens":[{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"性","s":"性","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"篤","s":"笃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愛","s":"爱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忍","s":"忍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乖","s":"乖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"離","s":"离","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"留","s":"留","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"京","s":"京","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"建初三年，78年。马防击破布桥，羌人多降，耿恭因得罪马防下狱免官。窦贵人被立为皇后。邓训建议停止难成的漕运工程，节省费用、保全役徒。班超攻破姑墨石城。章帝因不忍与诸王分离，把他们留在京城。","theme":"本篇对照了两种臣子。耿恭因「以言事忤马防」而获罪，可见外戚权势之盛；邓训「考量隐括，知其难成，具以上言」，使朝廷「岁省费亿万计，全活徒士数千人」，体现务实的作风。","technique":"本篇篇幅短小，按月份逐条记事。邓训一段先追述明帝时的旧役，「死者不可胜算」写出其害，再写邓训的考察与结果，因果分明；结尾章帝「性笃爱」，留诸王于京师，语气平和。","keyContentWords":[{"word":"虖","reading":"hū","note":"虖沱，河名。「治虖沱、石臼河」。"},{"word":"辇","reading":"niǎn","note":"车。「更用驴辇」。"},{"word":"溇","reading":"lóu","note":"溇中，地名。「武陵溇中蛮反」。"},{"word":"忤","reading":"wǔ","note":"触犯。「恭尝以言事忤马防」。"},{"word":"胜","reading":"shēng","note":"尽。「死者不可胜算」。"}],"keyFunctionWo