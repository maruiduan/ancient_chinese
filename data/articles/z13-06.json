vel":"dict"},{"t":"張","s":"张","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敖","s":"敖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"賜","s":"赐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謚","s":"谥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魯","s":"鲁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"元","s":"元","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉高后六年，前182年。太后因为吕王吕嘉骄横，废黜了他，立吕产为吕王。白天出现星星。大赦天下。封刘章的弟弟刘兴居为东牟侯，也入宫宿卫。匈奴侵犯狄道，攻打阿阳。发行五分钱。宣平侯张敖去世，赐谥鲁元王。","theme":"刘兴居和哥哥刘章同在宫中宿卫，后来诛吕、迎立代王都有他们的身影。吕嘉被废、吕产继立，说明太后对吕氏也要求驯服。","technique":"八句记事一句一事，彼此不相连属，读者需要把刘兴居入宿卫与后面诛吕的事联系起来看，才能体会司马光记录的用意。","keyContentWords":[{"word":"骄恣","reading":"jiāo zì","note":"骄横放纵。"},{"word":"五分钱","reading":"wǔ fēn qián","note":"汉初一种轻钱，分是重量单位。"},{"word":"谥","reading":"shì","note":"人死后根据生平给的称号。"}],"keyFunctionWords":[{"word":"亦","reading":"yì","note":"「亦入宿卫」，也，和前面刘章入宿卫相照应。"}],"ancientModern":[{"word":"寇","note":"这里是动词，侵犯，不是名词强盗。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"寇","note":"「匈奴寇狄道」，名词用作动词，侵犯。"},{"word":"居处","note":"「居处骄恣」，名词，日常生活起居。"}],"specialSyntax":[{"name":"被动句","note":"「废之」意思是吕嘉被废，用主动形式表达，主语是太后。"}]}}
