keyContentWords":[{"word":"和亲","reading":"hé qīn","note":"与外族通婚以求和好。刘敬建议以长公主嫁冒顿。"},{"word":"贾人","reading":"gǔ rén","note":"商人。贾读 gǔ，坐地经商的人。"},{"word":"单于","reading":"chán yú","note":"匈奴君主的称号，单读 chán。"}],"keyFunctionWords":[{"word":"诚","reading":"chéng","note":"「陛下诚能以适长公主妻之」，假设连词，如果真的。"},{"word":"固","reading":"gù","note":"「冒顿在，固为子婿」，副词，本来。"},{"word":"奈何","reading":"nài hé","note":"「奈何」，怎么办。"}],"ancientModern":[{"word":"妻","note":"「以适长公主妻之」，妻读 qì，名词用作动词，嫁给……做妻子。"},{"word":"子婿","note":"女婿，不是儿子和女婿两种人。"}],"phoneticLoans":[{"word":"适","note":"「适长公主」的适通嫡，读 dí，正妻所生的。"}],"flexibleUsage":[{"word":"妻","note":"「妻之」，名词用作动词，读 qì，把女儿嫁给他。"},{"word":"东","note":"「上东击韩王信余寇」，方位名词用作状语，向东。"}],"specialSyntax":[{"name":"判断句","note":"「柏人者，迫于人也」，用者……也表判断。"}]}}
