,{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"神","s":"神","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"氣","s":"气","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"采","s":"采","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"渭","s":"渭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廟","s":"庙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"汉文帝前十五年，前165年。黄龙在成纪出现，文帝召公孙臣为博士，草拟改历、易服色，张苍因此自退。文帝始幸雍郊祀五帝。诏举贤良能直言极谏者，晁错对策高第，擢为中大夫。新垣平以望气见文帝，作渭阳五帝庙。","theme":"这一年文帝开始热衷于祭祀和改制，方士新垣平得以进用，为下一年的骗局作了铺垫。晁错对策高第，又上书论削诸侯、更法令，文帝虽不尽听，却已奇其材，为景帝时晁错主持削藩埋下伏笔。","technique":"全年记事两条线索交错：一条是黄龙、郊祀、望气、五帝庙的祭祀改制，一条是举贤良、晁错对策的选官用人。司马光不加评论，只按时间依次排列，读者自然能看出文帝此时所好的变化。","keyContentWords":[{"word":"土德","reading":"tǔ dé","note":"五德终始说中的一德，认为汉朝应承土德，尚黄色。"},{"word":"望气","reading":"wàng qì","note":"观察云气来预言吉凶的方术。"},{"word":"对策","reading":"duì cè","note":"应试者回答皇帝所问政事的文章。"}],"keyFunctionWords":[{"word":"由此","reading":"yóu cǐ","note":"「张苍由此自绌」，因此。"},{"word":"凡","reading":"fán","note":"「书凡三十篇」，总共。"},{"word":"然","reading":"rán","note":"「然奇其材」，但是。"}],"ancientModern":[{"word":"服色","note":"车马、服饰的颜色，古人认为要和王朝的德运相配。"},{"word":"高第","note":"考试成绩优等，今天说名列前茅。"}],"phoneticLoans":[{"word":"见","note":"「黄龙见成纪」的见通现，读 xiàn。"},{"word":"绌","note":"「张苍由此自绌」的绌通黜，引退。"}],"flexibleUsage":[{"word":"奇","note":"「然奇其材」，形容词意动用法，认为……奇特。"},{"word":"策","note":"「上亲策之」，名词用作动词，出题考问。"}],"specialSyntax":[{"name":"省略句","note":"「拜为博士」，省略宾语之，即拜公孙臣为博士。"}]}}
