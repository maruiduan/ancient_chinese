:"dict"},{"t":"侍","s":"侍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"御","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"史","s":"史","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"宦","s":"宦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"官","s":"官","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"畏","s":"畏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"桓典常骑一匹青白色的骢马，京城的人因此为他编了一句话说：「走啊走啊快停下，躲开骑骢马的御史！」","tokens":[{"t":"典","s":"典","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乘","s":"乘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"驄","s":"骢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"京","s":"京","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"wèi","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"語","s":"语","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"止","s":"止","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"避","s":"避","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"驄","s":"骢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"御","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"史","s":"史","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"桓典是桓焉的孙子。","tokens":[{"t":"典","s":"典","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孫","s":"孙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"光和五年，182年。灵帝令公卿按谣言举劾州郡长官，许戫、张济却偏袒宦官子弟、诬劾清官，陈耽上言后被诬者改拜议郎。巴郡板楯蛮作乱，程包陈述板楯的功劳与冤苦，灵帝选派曹谦宣诏赦免，板楯即降。灵帝建四百尺观，校猎广成苑。桓典为侍御史，号称骢马御史。","theme":"本篇的重心是程包论板楯蛮。他先追述板楯「自秦世立功」，屡次助汉破羌，「忠功如此，本无恶心」；再说长吏「仆役棰楚，过于奴虏」，百姓「含怨呼天，无所叩诉」，所以才「邑落相聚以致叛戾」。结论是「但选明能牧守，自然安集」，后来果然「即时皆降」。可见叛乱的根源在于吏治，而不在边民本身。","technique":"本篇说理透彻。程包先褒其功，再陈其冤，后献其策，层层推进，事实充分。陈耽「放鸱枭而囚鸾凤」一语以鸟为喻，形象鲜明。结尾京师谚语「行行且止，避骢马御史」，以民谣写人，生动简洁。","keyContentWords":[{"word":"戫","reading":"yù","note":"人名用字。「太尉许戫、司空张济承望内官」。"},{"word":"赂","reading":"lù","note":"贿赂。「受取货赂」。"},{"word":"鸱","reading":"chī","note":"鸱枭，猫头鹰一类的鸟，比喻恶人。「所谓放鸱枭而囚鸾凤」。"},{"word":"楯","reading":"dùn","note":"同盾，板楯，族名。「板楯蛮寇乱巴郡」。"},{"word":"绲","reading":"gǔn","note":"人名用字。「前车骑将军冯绲南征武陵」。"},{"word":"颙","reading":"yóng","note":"人名用字。「太守李颙亦以板楯讨而平之」。"},{"word":"棰","reading":"chuí","note":"用棍子打。「仆役棰楚」。"},{"word":"刭","reading":"jǐng","note":"用刀割脖子。「或乃至自刭割」。"},{"word":"骢","reading":"cōng","note":"青白色的马。「典常乘骢马」。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"根据，凭借。「诏公卿以谣言举刺史」。"},{"word":"而","reading":"ér","note":"表转折。「而虚纠边远小郡清修有惠化者二十六人」。"},{"word":"亦","reading":"yì","note":"也。「亦倚板楯以成其功」。"},{"word":"虽","reading":"suī","note":"即使。「虽陈冤州郡」。"},{"word":"之","reading":"zhī","note":"代词，代板楯。「遣宣诏赦之」。"}],"ancientModern":[{"word":"计吏","note":"古义指上计吏，郡国派往京师呈报账簿的官吏；今无此词。「以问益州计吏汉中程包」。"},{"word":"不轨","note":"古义指违反法度，图谋叛乱；今义多指违法乱纪。「非有谋主僭号以图不轨」。"},{"word":"嫁妻卖子","note":"古义「妻」「子」分指妻子和儿女；今妻子连用只指配偶。「亦有嫁妻卖子」。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"让","note":"责备，动词。「帝以让戫、济」。"},{"word":"号","note":"称呼，名词作动词。「羌人号为神兵」。"}],"specialSyntax":[{"name":"判断句","note":"「典，焉之孙也」以「……也」表判断。"},{"name":"宾语前置","note":"「无所叩诉」中「所」字结构作宾语。"},{"name":"省略句","note":"「遣宣诏赦之」省略了被派遣者曹谦。"}]}}
