"word":"振赡","reading":"zhèn shàn","note":"救济。"},{"word":"弼凝","reading":"bì níng","note":"辅佐。"},{"word":"说谕","reading":"yuè yù","note":"高兴明白。"}],"keyFunctionWords":[{"word":"且","reading":"qiě","note":"暂且。「可且勿塞」。"},{"word":"孰","reading":"shú","note":"谁。「孰能无怨」。"},{"word":"盖","reading":"gài","note":"大概。「盖以此也」。"}],"ancientModern":[{"word":"党与","note":"古义指同伙；今义无此用法。「广汉郑躬等党与浸广」。"}],"phoneticLoans":[{"word":"振","note":"通“赈”。「上遣使者处业振赡之」。"},{"word":"说","note":"通“悦”。「则孰不说谕」。"}],"flexibleUsage":[{"word":"讥","note":"「《春秋》讥焉」，动词，讥讽。"},{"word":"重","note":"「二人皆重邺」，形容词的意动用法，以……为重，器重。"}],"specialSyntax":[{"name":"反问句","note":"「孰能无怨」，表反问。"},{"name":"判断句","note":"「此明诏所欲宠也」，用「……也」表判断。"}]}}
