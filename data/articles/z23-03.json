entWords":[{"word":"休沐","reading":"xiū mù","note":"官员休假。"},{"word":"甫","reading":"fǔ","note":"才，刚刚。"},{"word":"椒房","reading":"jiāo fáng","note":"皇后居住的宫殿，代指皇后。"},{"word":"故事","reading":"gù shì","note":"旧例，惯例。"},{"word":"尚主","reading":"shàng zhǔ","note":"娶公主。"}],"keyFunctionWords":[{"word":"因","reading":"yīn","note":"通过，凭借。「安欲因光内之宫中」。"},{"word":"诚","reading":"chéng","note":"如果真的。「诚因长主时得入为后」。"},{"word":"素","reading":"sù","note":"一向。「安素与外人善」。"}],"ancientModern":[{"word":"足下","note":"古义是对对方的敬称；今义指脚下。「成之在于足下」。"},{"word":"故事","note":"古义指旧例；今义指有情节的事情。「汉家故事」。"}],"phoneticLoans":[{"word":"内","note":"通“纳”，送入。「安欲因光内之宫中」。"}],"flexibleUsage":[{"word":"内","note":"「安欲因光内之宫中」，动词，送入，读 nà。"},{"word":"善","note":"「安素与外人善」，形容词用作动词，交好。"}],"specialSyntax":[{"name":"反问句","note":"「足下何忧不封侯乎」，用「何……乎」表反问。"},{"name":"判断句","note":"「光女为桀子安妻」，用「为」表判断。"}]}}
