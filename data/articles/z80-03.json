景","s":"景","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宗","s":"宗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祖","s":"祖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"发生大瘟疫，洛阳死的人以万计数。","tokens":[{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疫","s":"疫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"洛","s":"洛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"數","s":"数","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"咸宁元年，晋改元，大赦。吴掘地得银尺，也大赦，改元天册。贺邵此前上疏得罪吴主，这时中风不能言，离职数月。吴主疑他装病，收付酒藏，掠考千数，他始终不说话，于是烧锯断头，家属徙临海，楼玄的子孙也被杀。鲜卑拓跋力微再派儿子沙漠汗入贡，幽州刺史卫瓘请留他，并用金离间诸部大人。十二月追尊宣帝庙号高祖，景帝世宗，文帝太祖。洛阳大疫，死者以万数。","theme":"贺邵不能说话，吴主仍不肯放过，拷打上千次也问不出一句，最后用和陈声一样的烧锯。沉默在这里不是屈服。沙漠汗入贡将还，卫瓘留下他并离间部落，是后来鲜卑内乱的伏笔，这一年只写下留和赂。庙号从宣帝、景帝、文帝改成高祖、世宗、太祖，晋把自己的世系说成汉家式的祖宗。岁末的大疫把洛阳的死人数出来，不拿祥瑞去盖。","technique":"一年很短，改元、银尺、贺邵、沙漠汗、日食、庙号、大疫按季节排开。贺邵只用收付、掠考、无一言、烧锯、徙家五层，不再引他的疏。卫瓘的表和密赂写在同一句里，留下和离间同时发生。庙号三句并列，不解释为什么改。大疫单独成句，放在十二月追尊之后。","keyContentWords":[{"word":"酒藏","reading":"jiǔ zàng","note":"酒库，这里用来关人。「收付酒藏」。"},{"word":"掠考","reading":"lüè kǎo","note":"拷打审问。「掠考千数」。"},{"word":"烧锯","reading":"shāo jù","note":"烧热的锯子。「乃烧锯断其头」。"},{"word":"离间","reading":"lí jiàn","note":"使彼此不和。「离间之」。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"于是。「乃烧锯断其头」。"},{"word":"复","reading":"fù","note":"再，又。「复遣其子沙漠汗入贡」。"},{"word":"以","reading":"yǐ","note":"用。「密以金赂其诸部大人」。"},{"word":"其","reading":"qí","note":"他的。「徙其家属于临海」。"}],"ancientModern":[{"word":"大人","note":"这里是部落首领，不是泛称成年人。「诸部大人」。"},{"word":"藏","note":"这里读 zàng，是储藏的库，不是躲藏。「收付酒藏」。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"留","note":"使留下，不放回去。「表请留之」。"}],"specialSyntax":[{"name":"被动","note":"「卒无一言」承上文掠考，是被拷打之后始终不说话。"}]}}
